<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">


   <record id="group_warehouse_operation_restriction_for_users" model="res.groups">
        <field name="name">Warehouse Operation Restriction</field>
    </record>

       <record id="group_journal_restriction_for_users" model="res.groups">
        <field name="name">Journal Restriction</field>
    </record>

    <record id="warehouse_operations_restriction_for_users" model="ir.rule">
        <field name="name">Warehouse Operations restriction to users</field>
        <field  name="model_id" ref="stock.model_stock_picking_type"/>
        <field name="domain_force">[('id','not in', user.warehouse_operation_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('warehouse_journal_restriction.group_warehouse_operation_restriction_for_users'))]"/>
    </record>

        <record id="journal_restriction_for_users" model="ir.rule">
        <field name="name">Journals restriction to users</field>
        <field  name="model_id" ref="account.model_account_journal"/>
        <field name="domain_force">[('id','not in', user.journal_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('warehouse_journal_restriction.group_journal_restriction_for_users'))]"/>
    </record>




</odoo>