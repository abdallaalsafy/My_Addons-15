<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record model="ir.ui.view" id="mandoops_sells_search_id">
		<field name="name">Mandoops sells Search</field>
		<field name="model">mdl_mandoops_sells</field>
		<field name="arch" type="xml">
			<search>
				<field name="mdl_mandoops_id"/>
			</search>
		</field>
	</record>

	<record model="ir.ui.view" id="mandoops_sells_list_id">
		<field name="name">Mandoops Sells List</field>
		<field name="model">mdl_mandoops_sells</field>
		<field name="arch" type="xml">
			<tree decoration-bf='1' create="0" delete="0" import="0">
				<field name="mdl_mandoops_id"/>
                <field name="fld_total_sells" sum="Sum Totall Sells" optional = "show"/>
                <field name="fld_total_winning" sum="Sum Totall Winning" optional = "show"/>
				<field name="fld_total_qst" sum="Sum Totall Qest" optional = "hide"/>
                <field name="fld_win_qst" sum="Sum Win Qest" optional = "hide"/>
                <field name="fld_total" sum="Sum Totall" optional = "hide"/>
                <field name="fld_win" sum="Sum Totall Win" optional = "hide"/>
                <field name="fld_total_hafez" sum="Sum Totall Hafez" optional = "show"/>
                <field name="fld_count_cash" optional = "hide"/>
                <field name="fld_count_qst" optional = "hide"/>
                <field name="fld_count_cash_r" optional = "hide"/>
                <field name="fld_count_qst_r" optional = "hide"/>
                <field name="fld_count_sells" optional = "show"/>
                <field name="fld_count_sells_r" optional = "show"/>
			</tree>
		</field>
	</record>

	<record model="ir.ui.view" id="mandoops_sells_form_id">
		<field name="name">Mandoops Sells Form</field>
		<field name="model">mdl_mandoops_sells</field>
		<field name="arch" type="xml">
			<form  edit="0" create="0" delete="0">
                <h1>
                    <field name="mdl_mandoops_id"/>
                </h1>
                <group>
                    <group string="Cash">
                        <field name="fld_total"/>
                        <field name="fld_win"/>
                        <field name="fld_count_cash"/>
                        <field name="fld_count_cash_r"/>
                    </group>
                    <group string="Qest">
                        <field name="fld_total_qst"/>
                        <field name="fld_win_qst"/>
                        <field name="fld_count_qst"/>
                        <field name="fld_count_qst_r"/>
                    </group>
                </group>

				<group string="Glopal Data">
                    <field name="fld_total_sells"/>
                    <field name="fld_total_winning"/>
                    <field name="fld_total_hafez"/>
                    <field name="fld_count_sells"/>
                    <field name="fld_count_sells_r"/>
				</group>
			</form>
		</field>
	</record>
</odoo>
