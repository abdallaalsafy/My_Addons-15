<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record model="ir.ui.view" id="mandoops_goods_search_id">
		<field name="name">Mandoops Goods Search</field>
		<field name="model">mdl_mandoops_goods</field>
		<field name="arch" type="xml">
			<search>
				<field name="mdl_mandoops_id"/>
                <field name="fld_category_id"/>
                <field name="fld_goods_id"/>
                <filter string="Group Mandoop" name="group_Mandoop" context="{'group_by':'mdl_mandoops_id'}"/>
                <filter string="Group Goods" name="group_Goods" context="{'group_by':'fld_goods_id'}"/>
			</search>
		</field>
	</record>

	<record model="ir.ui.view" id="mandoops_goods_list_id">
		<field name="name">Mandoops Goods List</field>
		<field name="model">mdl_mandoops_goods</field>
		<field name="arch" type="xml">
			<tree decoration-bf='1' create="0" delete="0" import="0">
				<field name="mdl_mandoops_id"/>
                <field name="fld_category_id"/>
                <field name="fld_goods_id"/>
                <field name="fld_count"/>
                <field name="fld_unit_id"/>
				<field name="fld_total_qst_mandoop" sum="Sum Totall Qest For Mandoops"/>
                <field name="fld_total_sell_mandoop" sum="Sum Totall Cash For Mandoops"/>
                <field name="fld_total_sells"/>
                <field name="fld_total_hafez_mandoop" sum="Sum Totall Hafez For Mandoops"/>
                <field name="fld_win_mandoop" sum="Sum Totall Win For Mandoops"/>
			</tree>
		</field>
	</record>

	<record model="ir.ui.view" id="mandoops_goods_form_id">
		<field name="name">Mandoops Goods Form</field>
		<field name="model">mdl_mandoops_goods</field>
		<field name="arch" type="xml">
			<form  edit="0" create="0" delete="0">
                <h1>
                    <field name="mdl_mandoops_id"/>
                </h1>
                <group>
                    <field name="fld_category_id"/>
                    <field name="fld_goods_id"/>
                    <field name="fld_count"/>
                    <field name="fld_unit_id"/>
                    <field name="fld_total_qst_mandoop"/>
                    <field name="fld_total_sell_mandoop"/>
                    <field name="fld_total_sells"/>
                    <field name="fld_total_hafez_mandoop"/>
                    <field name="fld_win_mandoop"/>
                </group>
			</form>
		</field>
	</record>
</odoo>
