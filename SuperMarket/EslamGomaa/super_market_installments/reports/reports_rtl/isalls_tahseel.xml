<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
<!--ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc-->
        <template id="isalls_tahseel_template_id">
            <t t-if="not o" t-set="o" t-value="doc"/>
                <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>
<!--            ==============================================- -->
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                        <table style="border: 2px solid black;padding:0px;margin-top:15px;font-weight:bold;" >
                            <tr>
                                <td style="border:2px solid black; padding:0px; margin:0px;">
<!--                                    <div style="text-align:center; font-size:20px; width:300px; height:35px; overflow:hidden;" t-field="o.region.name"/>-->
                                    <div style="text-align:center; font-size:20px; width:300px; height:35px; overflow:hidden;">
                                        <t t-if="o.fld_sell_id.fld_region_id.name"> <span t-field="o.fld_sell_id.fld_region_id.name"/> </t>
                                        <t t-else= "" > <span style="color:white;">-</span> </t>
                                    </div>
                                </td>
                                <td style="width:70px;text-align: center;border: 2px solid black;padding:0px; margin:0px;">
                                    <span style="font-size: 16px; ">المنطقة</span>
                                </td>
                                <td style="vertical-align:middle; width:100px; text-align:center; border:2px solid black; padding:0px; margin:0px;">
                                    <span  style="font-size:20px;" t-field="o.fld_sell_id.fld_paying"/>
                                </td>
                                <td style="width:70px;text-align: center;border: 2px solid black;padding:0px; margin:0px;">
                                    <span style="font-size: 16px; ">المقدم</span>
                                </td>
                                <td  rowspan="2" style="vertical-align: middle;width:330px;text-align:center;border: 2px solid black;padding:0px; margin:0px;">
<!--                                    <img t-if="o.account_move_id.company_id.logo"-->
<!--                                         t-att-src="image_data_uri(o.account_move_id.company_id.logo)"-->
<!--                                         style="max-height: 50px;min-width: 150px;" alt="Logo"/>-->
                                        <span style="font-weight: bold;font-size:35px" t-field="company.name"/>
                                </td>
                                <td style="vertical-align:middle; width:70px; text-align:center; border:2px solid black; padding:0px; margin:0px;">
                                    <span style="font-size: 20px;" t-field="o.fld_num"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" style="border: 2px solid black;padding:0px; margin:0px;">
                                    <div style="padding-right:1px; text-align:right; font-size:16px; width:470px; height:70px; overflow:hidden;">
                                        <span style="color:white;">ـ</span>
                                        <t t-set="xNum" t-value="0"/>
                                        <t t-set="xIDs" t-value="len(o.fld_sell_id.fld_sells_goods_ids)"/>
                                        <t t-foreach="o.fld_sell_id.fld_sells_goods_ids" t-as="oo">
                                            <t t-set="xNum" t-value="xNum+1"/>
                                            <t t-if="xNum &lt;=4">
                                                <span t-esc="round(oo.fld_count)"/>
                                                <span t-field="oo.fld_goods_id.name"/>
                                                <span>سعر</span>
                                                <span t-esc="round(oo.fld_price_qst)"/>
                                                <span>جنيه</span>
                                                <t t-if="xNum &lt; xIDs" > <span>+</span> </t>
                                            </t>
                                            <t t-elif="xNum==5"> <span> ...ومنتجات اخري</span> </t>
                                        </t>
                                    </div>
                                </td>
                                <td  style="vertical-align:middle; text-align: center;border: 2px solid black;padding:0px; margin:0px;">
                                    <span style="font-size: 18px;">المنتج</span>
                                </td>
                                <td  style="vertical-align: middle;text-align: center;border: 2px solid black;padding:0px; margin:0px;">
                                    <span t-field="o.fld_sell_id.fld_num_isalls" style="font-size:20px"/>
                                </td>
                            </tr>
                        </table>
                        <table style="border: 2px solid white;border-right:2px solid black;border-left:2px solid black;padding:0px; margin:0px;font-weight:bold;">
                            <tr>
                                <td style="border: 2px solid white;border-left:2px solid black;padding:0px; margin:0px;">
                                    <div style="text-align:right;width:230px;height:35px;font-size:20px;padding-right:5px;overflow:hidden;">
                                        <t t-if="o.fld_sell_id.name"> <span t-field="o.fld_sell_id.name"/> </t>
                                        <t t-else= "" > <span style="color:white;">-</span> </t>
                                    </div>
                                </td>
                                <td style="vertical-align:middle;border:2px solid white; padding:0px; margin:0px; text-align:reight; width:100px;">
                                    <span style="font-size:16px">: كود الفاتورة</span>
                                </td>
                                <td style="border:2px solid white; padding:0px; margin:0px;">
                                    <div style="text-align:right; font-size:25px; width:470px; height:35px; overflow:hidden;">
                                        <t t-if="o.fld_sell_id.fld_customer_id.name"> <span t-field="o.fld_sell_id.fld_customer_id.name"/> </t>
                                        <t t-else= "" > <span style="color:white;">-</span> </t>
                                    </div>
                                </td>
                                <td style="vertical-align:middle; border:2px solid white; border-right:2px solid black; padding:0px 10px 0px 0px; margin:0px; text-align:left; width:125px;">
                                    <span style="font-size:16px">: اسم العميل</span>
                                </td>
                            </tr>
                            <tr>
                                <td style="border:2px solid white; border-left:2px solid black; padding:0px; margin:0px;">
                                    <div style="text-align:right; width:230px; height:33px; font-size:20px; padding-right:5px; overflow:hidden;">
                                        <t t-if="o.fld_sell_id.fld_customer_id.fld_phone"> <span t-field="o.fld_sell_id.fld_customer_id.fld_phone"/> </t>
                                        <t t-else="" > <span style="color:white;">-</span> </t>
                                    </div>
                                </td>
                                <td style="vertical-align:middle; border:2px solid white; padding:0px; margin:0px; text-align:left;">
                                    <span style="font-size:16px">: التليفون</span>
                                </td>
                                <td style="border:2px solid white; padding:0px; margin:0px;">
                                    <div style="text-align:right; font-size:22px; width:470px; height:33px; overflow:hidden;">
                                        <t t-if="o.fld_sell_id.fld_customer_id.fld_place_id.name"> <span t-field="o.fld_sell_id.fld_customer_id.fld_place_id.name"/> </t>
                                        <t t-else= "" > <span style="color:white;">-</span> </t>
                                    </div>
                                </td>
                                <td style="vertical-align:middle; border:2px solid white; border-right:2px solid black; padding:0px 10px 0px 0px; margin:0px; text-align:left;">
                                    <span style="font-size:16px">: عنوان العميل</span>
                                </td>
                            </tr>
                        </table>
                        <table style="border: 2px solid white;border-right:2px solid black;border-left:2px solid black;padding:0px;margin:0px;font-weight:bold;" class="table table-sm">
                            <tr>
                                <td style="font-size:21px; border:2pt solid white; border-left:2px solid black; border-right:2px solid black; padding:14px 10px 0px 10px; margin:0px; text-align:right;">
                                    <span>بموجب هذة الكمبيالة أتعهد بأن أدفع مبلغ</span>
                                    <span style="border:2pt solid black; padding:5px 10px 0px 10px; margin:0px 10px 0px 10px; font-size:23px;" t-esc="round(o.fld_amount)"/>
                                    <span>جـنيـة فـقـط لا غـيـر</span>
                                    <br/>
                                    <span>فى تاريخ :</span>
                                    <span>
                                        <t t-if="o.fld_reg_date"> <span style="padding:0px 10px 0px 10px;" t-field="o.fld_reg_date"/> </t>
                                        <t t-else= "" > <span style="color:white;">20-20-2020</span> </t>
                                    </span>
                                    <span>علـما بـأن القيمة وصلتنا بضـاعة والـدفع والتقاضى وفـقا لارادة الدائن دون التوقف علي رضائي تحريرا في يوم :</span>
                                    <span>
                                        <t t-if="o.fld_sell_id.fld_date"> <span style="padding:0px 10px 0px 0px;" t-field="o.fld_sell_id.fld_date"/> </t>
                                        <t t-else= "" > <span style="color:white;">20-20-2020</span> </t>
                                    </span>
                                </td>
                            </tr>
                        </table>
                        <table style="border: 2px solid black;padding:0px;margin-bottom:15px;font-weight:bold;" >
                            <tr>
                                <td style="width:600px;border: 2px solid black;padding:0px; margin:0px;text-align: center;border-bottom:1pt solid white;">
                                    <span style="font-size:20px" t-field="company.street"/>
                                </td>

                                <td style="width:100px;border: 2px solid black;padding:0px; margin:0px;text-align: center;">
                                    <t t-set="xMount" t-value="0"/>
                                    <t t-foreach="o.fld_sell_id.fld_isalls_ids" t-as="oo">
                                        <t t-if="oo.fld_num &gt; o.fld_num">
                                            <t t-set="xMount" t-value="xMount+oo.fld_amount"/>
                                        </t>
                                    </t>
                                    <span style="font-size:20px" t-esc="round(xMount)"/>
                                </td>
                                <td style="width:60px;border: 2px solid black;padding:0px; margin:0px;text-align: center;">
                                    <span style="font-size:16px">الباقي</span>
                                </td>
                                <td style="width:100px;border: 2px solid black;padding:0px; margin:0px;text-align: center;">
                                    <span style="font-size:20px" t-esc="round(o.fld_sell_id.fld_remain_qst)"/>
                                </td>
                                <td style="width:80px;border: 2px solid black;padding:0px; margin:0px;text-align: center;">
                                    <span style="font-size:16px">الاجمالي</span>
                                </td>
                            </tr>
                            <tr>
                              <td style="width:600px;border: 2px solid black;padding:0px; margin:0px;text-align: center;border-top:1pt solid white;">
                                <span style="font-size:25px">ت</span>
                                <span style="font-size:25px">:</span>
                                <span style="font-size:25px" t-field="company.phone"/>
                              </td>

                                <td colspan="3" style="border: 2px solid black;padding:0px; margin:0px;">
<!--                                    <div style="padding-right:3px; text-align:right; font-size:21px; width:255px; height:35px; overflow:hidden;" t-field="o.sales_man.name"/>-->
                                    <div style="padding-right:3px; text-align:right; font-size:21px; width:255px; height:35px; overflow:hidden;">
                                        <t t-if="o.fld_mandoops"> <span t-field="o.fld_mandoops[0].name"/> </t>
                                        <t t-else= "" > <span style="color:white;">-</span> </t>
                                    </div>
                                </td>
                                <td style="vertical-align:middle; border: 2px solid black;padding:0px; margin:0px;text-align: center;">
                                    <span style="font-size:16px">1المندوب</span>
                                </td>
                            </tr>
                            <tr>
                                <td style="vertical-align:middle; border:2px solid black;padding:0px; margin:0px; text-align:center; border-top:1pt solid white;">
                                    <span style="font-size:15px">البضاعة المباعة ترد او تستيدل خلال ١٤ يوم علي ان تكون في حالتها الاصلية</span>
                                </td>

                                <td colspan="3" style="border: 2px solid black;padding:0px; margin:0px;">
<!--                                    <div style="padding-right:3px; text-align:right; font-size:17px; width:255px; height:27px; overflow:hidden;" t-field="o.sales_person.name"/>-->
                                    <div style="padding-right:3px; text-align:right; font-size:17px; width:255px; height:27px; overflow:hidden;">
                                        <t t-if="o.fld_mandoops"> <span t-field="o.fld_mandoops[1].name"/> </t>
                                        <t t-else= "" > <span style="color:white;">-</span> </t>
                                    </div>
                                </td>
                                <td style="vertical-align:middle; border:2px solid black; padding:0px; margin:0px; text-align:center;">
                                    <span style="font-size:16px">المندوب2</span>
                                </td>
                            </tr>
                        </table>
                        <div>
                            ----------------------------------------------------------------------------------------------------------------------------------------------
                        </div>
                </t>
            </t>
        </template>
	</data>
</odoo>