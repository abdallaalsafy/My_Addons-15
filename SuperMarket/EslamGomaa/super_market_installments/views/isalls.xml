<odoo>
    <data>
        <record model="ir.ui.view" id="isalls_search_id">
		<field name="name">Isalls Search</field>
		<field name="model">mdl_isalls</field>
		<field name="arch" type="xml">
			<search>
                <field name="fld_sell_id"/>
                <field name="fld_customer_id"/>
                <field name="fld_phone"/>
                <field name="fld_region_id"/>
                <field name="fld_place_id"/>
                <field name="fld_address"/>
                <field name="fld_collctr_isal_id"/>
                <field name="fld_mandoops"/>
                <field name="fld_month"/>
                <field name="fld_year"/>

                <filter name="this_month" string="Isalls Of This Month"
                        domain="[('fld_is_printed','=',False),('fld_month','=',context_today().month),('fld_year','=',context_today().year)]"/>
                <filter name="next_month" string="Isalls Of Next Month"
                        domain="[('fld_is_printed','=',False),('fld_month','=',(context_today()+datetime.timedelta(31)).month),('fld_year','=',(context_today()+datetime.timedelta(31)).year)]"/>

                <separator/>
                <filter name="is_printed" string="Printed" domain="[('fld_is_printed','=',True)]"/>
				<filter name="not_printed" string="Not Printed" domain="[('fld_is_printed','=',False)]"/>
                <separator/>
                <filter name="is_paid" string="Paid" domain="[('fld_is_paid','=',True)]"/>
                <filter name="not_paid" string="Not Paid" domain="[('fld_is_paid','=',False)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter string="Fltr Reg Date" name="fltr_reg_date" date="fld_reg_date"/>
                <group name="group_by" string="Group By">
                    <filter string="Group By Sell" name="fltr_group_by_sell" context="{'group_by':'fld_sell_id'}"/>
                    <filter string="Group By Collctr_Isal" name="fltr_group_by_collctr_isal" context="{'group_by':'fld_collctr_isal_id'}"/>
                    <filter string="Group By Month" name="fltr_group_by_month" context="{'group_by':'fld_month'}"/>
                    <filter string="Group By Year" name="fltr_group_by_year" context="{'group_by':'fld_year'}"/>
                </group>
            </search>
		</field>
	</record>

        <record id="isalls_list_id" model="ir.ui.view">
            <field name="name">Isalls List</field>
            <field name="model">mdl_isalls</field>
            <field name="arch" type="xml">
                <tree create="0" delete="0">
                    <header>
                        <button name="fnc_print_isalls_tahseel" string="Print Isalls" type="object" class="oe_highlight"/>
                    </header>
                    <field name="fld_month" invisible="1"/>
                    <field name="fld_year" invisible="1"/>
                    <field name="fld_sell_id"/>
                    <field name="fld_customer_id"/>
                    <field name="fld_phone"/>
                    <field name="fld_region_id"/>
                    <field name="fld_place_id"/>
                    <field name="fld_mandoops"  widget="many2many_tags"/>
                    <field name="fld_collctr_isal_id"/>
                    <field name="fld_reg_date"/>
                    <field name="fld_amount" sum="Sum Amount Isalls"/>
                    <field name="fld_num"/>
                    <field name="fld_num_isalls"/>
                    <field name="fld_is_paid" widget="boolean_toggle"/>
                    <field name="fld_is_printed" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <record id="isalls_form_id" model="ir.ui.view">
            <field name="name">Isalls Form</field>
            <field name="model">mdl_isalls</field>
            <field name="arch" type="xml">
                <form create="0" delete="0" edit="0">
                    <field name="fld_month" invisible="1"/>
                    <field name="fld_year" invisible="1"/>
                    <header>
                        <button name="fnc_print_isalls_tahseel" string="Print Isalls" type="object" class="oe_highlight"/>
                    </header>
                    <sheet>
                         <group>
                            <group string="Sell Data">
                                <field name="fld_sell_id"/>
                                <field name="fld_reg_date"/>
                                <field name="fld_collctr_isal_id"/>
                                <field name="fld_mandoops" widget="many2many_tags"/>
                            </group>
                            <group string="Customer Data">
                                <field name="fld_customer_id"/>
                                <field name="fld_phone"/>
                                <field name="fld_region_id"/>
                                <field name="fld_place_id"/>
                            </group>
                        </group>
                        <group>
                            <group string="Isall Data">
                                <field name="fld_amount"/>
                                <field name="fld_num"/>
                                <field name="fld_num_isalls"/>
                            </group>
                            <group string="Isall Status">
                                <field name="fld_is_paid" widget="boolean_toggle"/>
                                <field name="fld_is_printed" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="isalls_action_id" model="ir.actions.act_window">
            <field name="name">Isalls Action</field>
            <field name="res_model">mdl_isalls</field>
            <field name="view_mode">tree,form</field>
            <field name="context" eval="{'search_default_next_month': 1}"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    There Is Not a Installment
                </p>
            </field>
        </record>

        <record id="paid_isalls_action_server_id" model="ir.actions.server">
            <field name="name">Paid Isalls Action Server</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="model_mdl_isalls"/>
            <field name="binding_model_id" ref="model_mdl_isalls"/>
            <field name="state">code</field>
            <field name="code">
                action = records.fnc_paid_isalls()
            </field>
        </record>
        <record id="cancel_paid_isalls_action_server_id" model="ir.actions.server">
            <field name="name">Cancel Paid Isalls Action Server</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="model_mdl_isalls"/>
            <field name="binding_model_id" ref="model_mdl_isalls"/>
            <field name="state">code</field>
            <field name="code">
                action = records.fnc_paid_isalls('>',True)
            </field>
        </record>
        <record id="cancel_received_isalls_action_server_id" model="ir.actions.server">
            <field name="name">Cancel Received Isalls Action Server</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="model_mdl_isalls"/>
            <field name="binding_model_id" ref="model_mdl_isalls"/>
            <field name="state">code</field>
            <field name="code">
                action = records.fnc_cancel_received_isalls()
            </field>
        </record>
        <record id="relay_isalls_action_server_id" model="ir.actions.server">
            <field name="name">Relay Isalls Action Server</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="model_mdl_isalls"/>
            <field name="binding_model_id" ref="model_mdl_isalls"/>
            <field name="state">code</field>
            <field name="code">
                action = records.fnc_relay_isalls()
            </field>
        </record>
    </data>
</odoo>



