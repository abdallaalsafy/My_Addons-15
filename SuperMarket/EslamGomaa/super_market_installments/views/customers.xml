<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record model="ir.ui.view" id="customers_search_id">
		<field name="name">Customers_Search</field>
		<field name="model">mdl_customers</field>
		<field name="inherit_id" ref="super_market_pro.customers_search_id"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='fld_phone']"     position="after">
                <field name="fld_code"/>
				<field name="fld_region_id"/>
				<field name="fld_place_id"/>
            </xpath>
			<xpath expr="//group"     position="inside">
				<filter name="group_region" string="Region" context="{'group_by':'fld_region_id'}"/>
				<filter name="group_place" string="Place" context="{'group_by':'fld_place_id'}"/>
            </xpath>
		</field>
	</record>

	<record model="ir.ui.view" id="customers_list_id">
		<field name="name">Customers_List</field>
		<field name="model">mdl_customers</field>
		<field name="inherit_id" ref="super_market_pro.customers_list_id"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='fld_phone']"     position="after">
                <field name="fld_code"/>
				<field name="fld_region_id"/>
				<field name="fld_place_id"/>
            </xpath>
		</field>
	</record>

	<record model="ir.ui.view" id="customers_form_id">
		<field name="name">Customers_Form</field>
		<field name="model">mdl_customers</field>
		<field name="inherit_id" ref="super_market_pro.customers_form_id"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='fld_phone']"     position="after">
				<field name="fld_code"/>
            </xpath>
			<xpath expr="//field[@name='fld_address']"     position="before">
				<field name="fld_region_id"/>
				<field name="fld_place_id" attrs="{'required':[('fld_region_id','!=',False)]}"/>
            </xpath>
		</field>
	</record>
</odoo>