#: model_terms:ir.actions.act_window,help:super_market_pro.customers_in_action_id
msgid ""
"Manage customer payments, track payment status, and maintain accurate "
"financial records."
msgstr ""
"إدارة مدفوعات العملاء، متابعة حالة الدفع، والحفاظ على سجلات مالية دقيقة."

#. module: super_market_pro
#: model_terms:ir.actions.act_window,help:super_market_pro.customers_out_action_id
msgid ""
"Manage customer refunds, track refund status, and maintain accurate "
"financial records."
msgstr ""
"إدارة استردادات العملاء، متابعة حالة الاسترداد، والحفاظ على سجلات مالية دقيقة."

#. module: super_market_pro
#: model_terms:ir.actions.act_window,help:super_market_pro.spending_action_id
msgid ""
"Manage daily expenses, track spending by category, and maintain accurate "
"financial records."
msgstr ""
"إدارة المصروفات اليومية، متابعة الإنفاق حسب التصنيف، والحفاظ على سجلات مالية دقيقة."

#. module: super_market_pro
#: model_terms:ir.actions.act_window,help:super_market_pro.inventorys_action_id
msgid ""
"Manage inventory counts, track stock levels, and maintain accurate inventory"
" records."
msgstr ""
"إدارة أعداد الجرد، متابعة مستويات المخزون، والحفاظ على سجلات جرد دقيقة."

#. module: super_market_pro
#: model_terms:ir.actions.act_window,help:super_market_pro.buys_r_action_id
msgid "Manage purchase returns, track refunds, and monitor discounts."
msgstr "إدارة مرتجعات الشراء، متابعة الاستردادات، ومراقبة الخصومات."

#. module: super_market_pro
#: model_terms:ir.actions.act_window,help:super_market_pro.sells_r_action_id
msgid "Manage return sales orders, track payments, and monitor profit/loss."
msgstr "إدارة مرتجعات المبيعات، متابعة المدفوعات، ومراقبة الربح/الخسارة."

#. module: super_market_pro
#: model_terms:ir.actions.act_window,help:super_market_pro.charges_action_id
msgid ""
"Manage stock transfers between stores, track inventory movements, and "
"maintain accurate stock levels."
msgstr ""
