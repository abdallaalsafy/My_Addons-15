<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record model="ir.ui.view" id="goods_calc_search_id">
		<field name="name">Goods_Calc_Search</field>
		<field name="model">mdl_goods_calc</field>
		<field name="arch" type="xml">
			<search>
				<field name="fld_category_id"/>
				<field name="fld_goods_id"/>
                <field name="fld_unit_id"/>
			</search>
		</field>
	</record>

	<record model="ir.ui.view" id="goods_calc_list_id">
		<field name="name">Goods_Calc_List</field>
		<field name="model">mdl_goods_calc</field>
		<field name="arch" type="xml">
			<tree decoration-bf='1' create="0" delete="0" import="0">
				<field name="fld_category_id"/>
				<field name="fld_goods_id"/>
                <field name="fld_unit_id"/>
				<field name="fld_count"/>
				<field name="fld_clc_sell" widget="monetary" sum="Sum Sell"/>
				<field name="fld_clc_buy" widget="monetary" sum="Sum Buy"/>
				<field name="fld_win" widget="monetary" sum="Sum Win"/>
			</tree>
		</field>
	</record>

	<record model="ir.ui.view" id="goods_calc_form_id">
		<field name="name">Goods_Calc_Form</field>
		<field name="model">mdl_goods_calc</field>
		<field name="arch" type="xml">
			<form  edit="0" create="0" delete="0">
				<sheet>
					<div class="oe_title">
						<h1><field name="fld_goods_id"/></h1>
					</div>
					<group>
					<field name="fld_category_id"/>
					<span class="o_form_label o_td_label">Count</span>
					<div class="o_address_format">
						<field name="fld_count" widget="monetary" class="o_address_city"/>
						<field name="fld_unit_id" class="o_address_zip"/>
					</div>
					<field name="fld_price_buy" widget="monetary"/>
					<field name="fld_price_sell" widget="monetary"/>
					<field name="fld_clc_sell" widget="monetary"/>
					<field name="fld_clc_buy" widget="monetary"/>
					<field name="fld_win" widget="monetary"/>
				</group>
				</sheet>
			</form>
		</field>
	</record>

	<record model="ir.actions.act_window" id="goods_calc_action_id">
        <field name="name">Goods_Calc_Action</field>
        <field name="res_model">mdl_goods_calc</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
