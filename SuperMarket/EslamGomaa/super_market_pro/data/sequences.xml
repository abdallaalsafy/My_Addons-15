<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="buy_sqnce_id" model="ir.sequence">
            <field name="name">Buy Sequence</field>
            <field name="code">buy_sqnce</field>
                <field name="prefix">Bll-</field>
                <field name="suffix">-%(y)s</field>
                <field name="padding">5</field>
            <field name="number_increment"    eval="1"/>
        </record>

        <record id="buy_rtrn_sqnce_id" model="ir.sequence">
            <field name="name">Return Buy Sequence</field>
            <field name="code">buy_r_sqnce</field>
                <field name="prefix">RB-</field>
                <field name="suffix">-%(y)s</field>
                <field name="padding">5</field>
            <field name="number_increment"    eval="1"/>
        </record>
        <record id="sell_sqnce_id" model="ir.sequence">
            <field name="name">Sell Sequence</field>
            <field name="code">sell_sqnce</field>
                <field name="prefix">Sll-</field>
                <field name="suffix">-%(y)s</field>
                <field name="padding">5</field>
            <field name="number_increment"    eval="1"/>
        </record>

        <record id="sell_r_sqnce_id" model="ir.sequence">
            <field name="name">Return Sell Sequence</field>
            <field name="code">sell_r_sqnce</field>
                <field name="prefix">RS-</field>
                <field name="suffix">-%(y)s</field>
                <field name="padding">5</field>
            <field name="number_increment"    eval="1"/>
        </record>
        <record id="chrg_sqnce_id" model="ir.sequence">
            <field name="name">Charge Sequence</field>
            <field name="code">chrg_sqnce</field>
                <field name="prefix">CRG-</field>
                <field name="suffix">-%(y)s</field>
                <field name="padding">5</field>
            <field name="number_increment"    eval="1"/>
        </record>
        <!--                      mdl_paying                          -->
        <record id="out_sqnce_id" model="ir.sequence">
            <field name="name">Out Sequence</field>
            <field name="code">out_sqnce</field>
                <field name="prefix">OUT-</field>
                <field name="suffix">-%(y)s</field>
                <field name="padding">5</field>
            <field name="number_increment"    eval="1"/>
        </record>
        <record id="in_sqnce_id" model="ir.sequence">
