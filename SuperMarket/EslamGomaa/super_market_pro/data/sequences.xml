            <field name="number_increment"    eval="1"/>
        </record>
    <!--              mdl_inventorys                     -->
        <record id="inventory_sqnce_id" model="ir.sequence">
            <field name="name">Inventory Sequence</field>
            <field name="code">inv_sqnce</field>
                <field name="prefix">INV-</field>
                <field name="suffix">-%(y)s</field>
                <field name="padding">5</field>
            <field name="number_increment"    eval="1"/>
        </record>
    </data>
</odoo>