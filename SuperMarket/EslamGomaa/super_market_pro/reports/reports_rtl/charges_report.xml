<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
<!--ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc-->
        <template id="charges_template_id">
            <t t-if="not o" t-set="o" t-value="doc"/>
                <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>
<!--            ==============================================- -->
            <t t-call="web.basic_layout">
                <table>
                    <thead>
<!--                        ===============================   -->
                        <tr>
                            <th colspan="2"><div style="width:150px; height:150px;" t-field = "company.logo" t-options = "{'widget':'image'}"/></th>
                            <th class="text-right" colspan="5">
                                <span t-field="company.name"/>
                                <br/>
                                <span t-field="company.street"/>
                                <span t-if="company.street and company.street2">-/-</span>
                                <span t-field="company.street2"/>
                                <br/>
                                <span t-field="company.mobile"/>
                                <span t-if="company.mobile and company.phone">-/-</span>
                                <span t-field="company.phone"/>
                            </th>
                        </tr>
<!--                        ===============================    -->
                        <tr>
                            <th class="text-center" colspan="2"><p t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d---%H:%M:%S')"/></th>
                            <th class="text-center" colspan="5" style="height:35px;">
                                <h3>Kashf Of Charges</h3>
                            </th>
                        </tr>
<!--                        ================================    -->
                        <tr class="text-center" style="background-color:rgb(218,218,218);">
                            <th style="border:1px solid black;vertical-align:middle;">Count Items</th>
                            <th style="border:1px solid black;vertical-align:middle;">To Store</th>
                            <th style="border:1px solid black;vertical-align:middle;">From Store</th>
                            <th style="border:1px solid black;vertical-align:middle;">Date</th>
                            <th style="border:1px solid black;vertical-align:middle;">Referance</th>
                            <th style="border:1px solid black;vertical-align:middle;">Code</th>
                            <th style="border:1px solid black;vertical-align:middle;">M</th>
                        </tr>
                    </thead>
                    <t t-set="x" t-value="0"/>
                    <t t-foreach="docs" t-as="o">
                        <t t-set = "x"  t-value = "x+1"/>
                        <tbody   style="font-family:tahoma;">
                            <tr>
                                <td style="border:1px solid black; vertical-align:middle;">
                                    <div style="text-align:center; font-size:16px;width:120px; height:35px; padding:3px;overflow:hidden;">
                                        <span t-esc="len(o.fld_charges_goods_ids)"/>
                                    </div>
                                </td>
                                <td style="border:1px solid black; vertical-align:middle;">
                                    <div style="text-align:center; font-size:16px; width:200px; height:35px;overflow:hidden;">
                                        <span t-field="o.fld_store_t_id"/>
                                    </div>
                                </td>
                                <td style="border:1px solid black; vertical-align:middle;">
                                    <div style="text-align:center; font-size:16px; width:200px; height:35px; padding:3px;overflow:hidden;">
                                        <span t-field="o.fld_store_f_id"/>
                                    </div>
                                </td>
                                <td class="text-right" style="border:1px solid black; vertical-align:middle;">
                                    <div style="font-size:16px; width:90px;height:35px; padding:3px;overflow:hidden;">
                                        <span t-field="o.fld_date"/>
                                    </div>
                                </td>
                                <td class="text-right" style="border:1px solid black; vertical-align:middle;">
                                    <div style="font-size:16px; width:100px;height:35px; padding:3px;overflow:hidden;">
                                        <span t-field="o.fld_ref"/>
                                    </div>
                                </td>
                                <td class="text-right" style="border:1px solid black; vertical-align:middle;">
                                    <div style="font-size:16px; width:125px;height:35px; padding:3px;overflow:hidden;">
                                        <span t-field="o.name"/>
                                    </div>
                                </td>
                                <td style="border:1px solid black; vertical-align:middle;background-color:rgb(218,218,218);">
                                    <div style="text-align:center; font-size:14px; width:50px; height:35px; overflow:hidden;">
                                        <p t-esc = "x"/>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </t>
                </table>
            </t>
        </template>
    </data>
</odoo>
