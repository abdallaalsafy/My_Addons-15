<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
	<!--ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc-->
        <template id="buys_goods_template_id">
            <t t-if="not o" t-set="o" t-value="doc"/>
            <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>
<!--            ==============================================- -->
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <table>
                                <tr>
                                    <td class="text-left" colspan="3">
                                        <span t-field="company.name"/>
                                        <br/>
                                        <span t-field="company.street"/>
                                        <span t-if="company.street and company.street2">-/-</span>
                                        <span t-field="company.street2"/>
                                        <br/>
                                        <span t-field="company.mobile"/>
                                        <span t-if="company.mobile and company.phone">-/-</span>
                                        <span t-field="company.phone"/>
                                    </td>
                                    <td><div style="width:150px; height:150px;" t-field = "company.logo" t-options = "{'widget':'image'}"/></td>
                                </tr>
                                <tr>
                                    <td class="text-center" colspan="3" style="height:35px;font-size:20px;font-weight:bold;">
                                        <h3>Buys Details</h3>
                                    </td>
                                    <td class="text-center"><p t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d---%H:%M:%S')"/></td>
                                </tr>
                                <tr>
                                    <td class="text-left" style=" vertical-align:middle;">
                                        <div style="font-size:16px;width:100px; height:35px; padding:3px;overflow:hidden;">
                                            <p>Vendor:</p>
                                        </div>
                                    </td>
                                    <td class="text-left" style="vertical-align:middle;">
                                        <div style="font-size:20px;width:500px; height:35px; padding:3px;overflow:hidden;">
                                            <p t-field="o.fld_vendor_id"/>
                                        </div>
                                    </td>
                                    <td class="text-left" style="vertical-align:middle;">
                                        <div style="font-size:16px;width:100px; height:35px; padding:3px;overflow:hidden;">
                                            <p>Code:</p>
                                        </div>
                                    </td>
                                    <td class="text-left"  style="vertical-align:middle;">
                                        <div style="font-size:20px;width:200px; height:35px; padding:3px;overflow:hidden;">
                                            <p t-field="o.name"/>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-left" style="vertical-align:middle;">
                                        <div style="font-size:16px;width:100px; height:35px; padding:3px;overflow:hidden;">
                                            <p>Phone:</p>
                                        </div>
                                    </td>
                                    <td class="text-left" style="vertical-align:middle;">
                                        <div style="font-size:20px;width:500px; height:35px; padding:3px;overflow:hidden;">
                                            <p  t-field="o.fld_vendor_id.fld_phone"/>
                                        </div>
                                    </td>
                                    <td class="text-left" style="vertical-align:middle;">
                                        <div style="font-size:16px;width:100px; height:35px; padding:3px;overflow:hidden;">
                                            <p>Referance:</p>
                                        </div>
                                    </td>
                                    <td class="text-left" style="vertical-align:middle;">
                                        <div style="font-size:20px;width:200px; height:35px; padding:3px;overflow:hidden;">
                                            <p t-field="o.fld_ref"/>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-left" style="vertical-align:middle;">
                                        <div style="font-size:16px;width:100px; height:35px; padding:3px;overflow:hidden;">
                                            <p >Address:</p>
                                        </div>
                                    </td>
                                    <td class="text-left" style="vertical-align:middle;">
                                        <div style="font-size:18px;width:500px; height:35px; padding:3px;overflow:hidden;">
                                            <p t-field="o.fld_vendor_id.fld_address"/>
                                        </div>
                                    </td>
                                    <td class="text-left" style="vertical-align:middle;">
                                        <div style="font-size:16px;width:100px; height:35px; padding:3px;overflow:hidden;">
                                            <p>Date:</p>
                                        </div>
                                    </td>
                                    <td class="text-left" style="vertical-align:middle;">
                                        <div style="font-size:20px;width:200px; height:35px; padding:3px;overflow:hidden;">
                                            <p t-field="o.fld_date"/>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                            <table>
                                <thead>
                                    <tr class="text-center" style="background-color:rgb(218,218,218);">
                                        <th style="border:1px solid black;vertical-align:middle;"><span>M</span></th>
                                        <th style="border:1px solid black;vertical-align:middle;"><span>Store</span></th>
                                        <th style="border:1px solid black;vertical-align:middle;"><span>Goods</span></th>
                                        <th style="border:1px solid black;vertical-align:middle;"><span>Count</span></th>
                                        <th style="border:1px solid black;vertical-align:middle;"><span>Unit</span></th>
                                        <th style="border:1px solid black;vertical-align:middle;"><span>Price</span></th>
                                        <th style="border:1px solid black;vertical-align:middle;"><span>Total</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="lns" t-value="o.fld_buys_goods_ids"/>
                                    <t t-set="x" t-value="0"/>
                                    <t t-foreach="lns" t-as="ln">
                                        <t t-set = "x"  t-value = "x+1"/>
                                        <tr>
                                            <td style="border:1px solid black; vertical-align:middle;background-color:rgb(218,218,218);">
                                                <div style="text-align:center; font-size:14px; width:50px; height:35px; overflow:hidden;">
                                                    <p t-esc = "x"/>
                                                </div>
                                            </td>
                                            <td class="text-left" style="border:1px solid black; vertical-align:middle;">
                                                <div style="font-size:16px;width:150px; height:35px; padding:3px;overflow:hidden;">
                                                    <span t-field="ln.fld_store_id"/>
                                                </div>
                                            </td>
                                            <td class="text-left" style="border:1px solid black; vertical-align:middle;">
                                                <div style="font-size:16px;width:300px; height:35px; padding:3px;overflow:hidden;">
                                                    <span t-field="ln.fld_goods_id"/>
                                                </div>
                                            </td>
                                            <td style="border:1px solid black; vertical-align:middle;">
                                                <div style="text-align:center; font-size:16px;width:75px; height:35px; padding:3px;overflow:hidden;">
                                                    <span t-field="ln.fld_count"/>
                                                </div>
                                            </td>
                                            <td style="border:1px solid black; vertical-align:middle;">
                                                <div style="text-align:center; font-size:16px;width:75px; height:35px; padding:3px;overflow:hidden;">
                                                    <span t-field="ln.fld_unit_id"/>
                                                </div>
                                            </td>
                                            <td style="border:1px solid black; vertical-align:middle;">
                                                <div style="text-align:center; font-size:16px;width:125px; height:35px; padding:3px;overflow:hidden;">
                                                    <span t-field="ln.fld_price_buy"/>
                                                </div>
                                            </td>
                                            <td style="border:1px solid black; vertical-align:middle;">
                                                <div style="text-align:center; font-size:16px;width:150px; height:35px; padding:3px;overflow:hidden;">
                                                    <span t-field="ln.fld_clc_buy"/>
                                                </div>
                                            </td>
                                        </tr>
                                    </t>
  <!--                    ============================   -->
                                    <tr class="text-center">
                                        <td colspan="5"> </td>
                                        <td style="border:1px solid black;background-color:rgb(218,218,218);vertical-align:middle;">
                                            Total
                                        </td>
                                        <td  style="border:1px solid black;vertical-align:middle;">
                                            <p t-esc ="o.fld_total"/>
                                        </td>
                                    </tr>
                                    <tr class="text-center">
                                        <td colspan="5"> </td>
                                        <td style="border:1px solid black;background-color:rgb(218,218,218);vertical-align:middle;">
                                            Paying
                                        </td>
                                        <td  style="border:1px solid black;vertical-align:middle;">
                                            <p t-esc ="o.fld_paying"/>
                                        </td>
                                    </tr>
                                    <tr class="text-center">
                                        <td colspan="5"> </td>
                                        <td style="border:1px solid black;background-color:rgb(218,218,218);vertical-align:middle;">
                                            Discount
                                        </td>
                                        <td style="border:1px solid black;vertical-align:middle;">
                                            <p t-esc ="o.fld_discount"/>
                                        </td>
                                    </tr>
                                    <tr class="text-center">
                                        <td colspan="5"> </td>
                                        <td style="border:2px solid black;background-color:rgb(218,218,218);vertical-align:middle;">
                                            Remain
                                        </td>
                                        <td style="border:2px solid black;vertical-align:middle;">
                                            <p t-esc ="o.fld_remain"/>
                                        </td>
                                    </tr>
<!--                    ===================================   -->
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>

