<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
	<!--ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc-->
        <template id="goods_stores_template_id">
            <t t-if="not o" t-set="o" t-value="doc"/>
                <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>
<!--            ==============================================- -->
            <t t-call="web.basic_layout">
                <table>
                    <thead>
                        <tr>
                            <th class="text-left" colspan="4">
                                <span t-field="company.name"/>
                                <br/>
                                <span t-field="company.street"/>
                                <span t-if="company.street and company.street2">-/-</span>
                                <span t-field="company.street2"/>
                                <br/>
                                <span t-field="company.mobile"/>
                                <span t-if="company.mobile and company.phone">-/-</span>
                                <span t-field="company.phone"/>
                            </th>
                            <th colspan="2"><div style="width:150px; height:150px;" t-field = "company.logo" t-options = "{'widget':'image'}"/></th>
                        </tr>
                        <tr>
                            <th class="text-center" colspan="4" style="height:35px;">
                                <h3>Kashf Of Goods Stores</h3>
                            </th>
                            <th colspan="2" class="text-center"><p t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d---%H:%M:%S')"/></th>
                        </tr>
                        <tr class="text-center" style="background-color:rgb(218,218,218);">
                            <th style="border:1px solid black;vertical-align:middle;">M</th>
                            <th style="border:1px solid black;vertical-align:middle;">Store</th>
                            <th style="border:1px solid black;vertical-align:middle;">Goods</th>
                            <th style="border:1px solid black;vertical-align:middle;">Category</th>
                            <th style="border:1px solid black;vertical-align:middle;">Unit</th>
                            <th style="border:1px solid black;vertical-align:middle;">Count</th>
                        </tr>
                    </thead>
                    <t t-set="x" t-value="0"/>
                    <t t-foreach="docs" t-as="o">
                        <t t-set = "x"  t-value = "x+1"/>
                        <tbody  style="font-family:tahoma;">
                            <tr>
                                <td style="border:1px solid black; vertical-align:middle;background-color:rgb(218,218,218);">
                                    <div style="text-align:center; font-size:14px; width:50px; height:35px; overflow:hidden;">
                                        <span t-esc = "x"/>
                                    </div>
                                </td>
                                <td class="text-left" style="border:1px solid black; vertical-align:middle;">
                                    <div style="font-size:16px; width:240px;height:35px; padding:3px;overflow:hidden;">
                                        <span t-field="o.fld_store_id"/>
                                    </div>
                                </td>
                                <td class="text-left" style="border:1px solid black; vertical-align:middle;">
                                    <div style="font-size:16px; width:300px;height:35px; padding:3px;overflow:hidden;">
                                        <span t-field="o.fld_goods_id"/>
                                    </div>
                                </td>
                                <td class="text-left" style="border:1px solid black; vertical-align:middle;">
                                    <div style="font-size:16px; width:120px; height:35px; padding:3px;overflow:hidden;">
                                        <span t-field="o.fld_category_id"/>
                                    </div>
                                </td>
                                <td style="border:1px solid black; vertical-align:middle;">
                                    <div style="text-align:center; font-size:16px; width:100px; height:35px;overflow:hidden;">
                                        <span t-field="o.fld_unit_id"/>
                                    </div>
                                </td>
                                <td style="border:1px solid black; vertical-align:middle;">
                                    <div style="text-align:center; font-size:16px;width:120px; height:35px; padding:3px;overflow:hidden;">
                                        <span t-field="o.fld_count"/>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </t>
                </table>
            </t>
        </template>
    </data>
</odoo>

