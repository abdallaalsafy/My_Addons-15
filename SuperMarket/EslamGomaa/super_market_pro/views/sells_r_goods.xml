<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="search_sells_r_goods_search_id">
        <field name="name">Search Return Sales Goods</field>
        <field name="model">mdl_sells_r_goods</field>
        <field name="arch" type="xml">
            <search string="Search Return Sales Goods">
                <!-- Search Fields -->
                <field name="fld_goods_id" filter_domain="[('fld_goods_id.name','ilike',self)]"/>
                <field name="fld_category_id" string="Category"/>
                <field name="fld_unit_id" string="Unit"/>
                <field name="fld_sells_r_id" string="Return Sale"/>
                <field name="fld_store_id" string="Store"/>
                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter string="Goods" name="group_goods" context="{'group_by':'fld_goods_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by':'fld_category_id'}"/>
                    <filter string="Return Sale" name="group_return_sale" context="{'group_by':'fld_sells_r_id'}"/>
                    <filter string="Store" name="group_store" context="{'group_by':'fld_store_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tree View -->
    <record model="ir.ui.view" id="sells_r_goods_list_id">
        <field name="name">Return Sales Goods List</field>
        <field name="model">mdl_sells_r_goods</field>
        <field name="arch" type="xml">
            <tree string="Return Sales Goods" decoration-bf="1">
                <field name="fld_goods_id"/>
                <field name="fld_category_id"/>
                <field name="fld_count"/>
                <field name="fld_unit_id"/>
                <field name="fld_price_sell" widget="monetary"/>
                <field name="fld_clc_sell" widget="monetary"/>
                <field name="fld_win" widget="monetary" optional="hide" groups="super_market_pro.super_market_manager_group"/>
                <field name="fld_store_id"/>
            </tree>
        </field>
    </record>
    <record model="ir.ui.view" id="search_sells_r_goods_list_id">
		<field name="name">Search_Sells_R_Goods_List</field>
		<field name="model">mdl_sells_r_goods</field>
		<field name="arch" type="xml">
			<tree decoration-bf='1' create="0" delete="0" import="0">
                <field name="fld_date"/>
                <field name="fld_sells_r_id"/>
                <field name="fld_customer_id"/>
				<field name="fld_goods_id"/>
				<field name="fld_count"/>
				<field name="fld_unit_id"/>
				<field name="fld_price_sell" groups="super_market_pro.super_market_manager_group"/>
				<field name="fld_clc_sell" groups="super_market_pro.super_market_manager_group" sum="Sum Totall Clc_Sell"/>
				<field name="fld_store_id"/>
			</tree>
		</field>
	</record>

    <!-- Form View -->
    <record model="ir.ui.view" id="sells_r_goods_form_id">
        <field name="name">Return Sales Goods Form</field>
        <field name="model">mdl_sells_r_goods</field>
        <field name="arch" type="xml">
            <form string="Return Sales Goods">
                <sheet>
                    <!-- Hidden computed fields -->
                    <field name="fld_clc_buy" invisible="1"/>
                    <field name="fld_clc_sell" invisible="1"/>
                    <field name="fld_win" invisible="1"/>
                    <field name="fld_count_ref_unit" invisible="1"/>
                    <field name="fld_unit_catg_id" invisible="1"/>
                    
                    <!-- Basic Information -->
                    <group>
                        <group name="basic_info">
                            <field name="fld_category_id" options="{'no_create': True}"/>
                            <field name="fld_goods_id"  options="{'no_quick_create': True}"/>
                        </group>
                        <group name="quantity_info">
                            <field name="fld_count" placeholder="Enter quantity..."/>
                            <field name="fld_unit_id" options="{'no_create':True, 'no_open':True}"/>
                        </group>
                    </group>
                    
                    <!-- Pricing Information -->
                    <group>
                        <group name="pricing_info">
                            <field name="fld_price_sell" widget="monetary" placeholder="0.00"/>
                            <field name="fld_price_buy" force_save="1" widget="monetary" groups="super_market_pro.super_market_manager_group"/>
                        </group>
                         <group name="store_info">
                            <field name="fld_store_id" options="{'no_create': True}"/>
                             <field name="fld_count_store" widget="monetary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action Window -->
    <record model="ir.actions.act_window" id="sells_r_goods_action_id">
        <field name="name">Return Sales Goods</field>
        <field name="res_model">mdl_sells_r_goods</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add goods to return sales order
            </p>
            <p>
                Select goods, quantities, and units to add to your return sales order.
            </p>
        </field>
    </record>
</odoo>
