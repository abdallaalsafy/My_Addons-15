<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record model="ir.ui.view" id="customers_search_id">
		<field name="name">Customers_Search</field>
		<field name="model">mdl_customers</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>
				<field name="fld_star_name"/>
				<field name="fld_phone"/>
				<field name="fld_address"/>
				<field name="fld_notes"/>
				<filter name="archived" string="Archived" domain="[('active','=',False)]"/>
				<filter string="Active" name="active" domain="[('active','=',True)]"/>
				<separator/>
				<filter string="Has Phone" name="has_phone" domain="[('fld_phone','!=',False)]"/>
				<separator/>
				<filter string="Restricted Customers" name="restricted" domain="[('has_restriction', '=', True)]"/>
				<filter string="Non-Restricted Customers" name="non_restricted" domain="[('has_restriction', '=', False)]"/>
				<filter string="Customers with Balance" name="has_balance" domain="[('balance', '&gt;', 0)]"/>
				<filter string="Customers with Credit" name="has_credit" domain="[('balance', '&lt;', 0)]"/>
				<separator/>
				<!-- Group By -->
				<group expand="0" string="Group By">
					<filter string="Restriction Status" name="group_restriction" context="{'group_by':'has_restriction'}"/>
				</group>
			</search>
		</field>
	</record>

	<record model="ir.ui.view" id="customers_list_id">
		<field name="name">Customers_List</field>
		<field name="model">mdl_customers</field>
		<field name="arch" type="xml">
			<tree decoration-bf='1' decoration-danger='has_restriction==True'>
				<field name="name"/>
				<field name="fld_star_name"/>
				<field name="fld_phone"/>
				<field name="fld_address"/>
				<field name="balance" widget="monetary" optional="hide"  decoration-warning='balance &lt; 0'
					sum="Total Balance" groups="super_market_pro.super_market_manager_group"/>
				<field name="has_restriction" widget="boolean_toggle" optional="show" readonly="1"/>
			</tree>
		</field>
	</record>

	<record model="ir.ui.view" id="customers_form_id">
		<field name="name">Customers_Form</field>
		<field name="model">mdl_customers</field>
		<field name="arch" type="xml">
			<form>
				<header></header>
				<sheet>
					<div class="oe_button_box" name="button_box">
						<button name="action_view_sells" type="object" class="oe_stat_button" icon="fa-shopping-cart"
							attrs="{'invisible': [('sells_count', '=', 0)]}">
							<field name="sells_count" widget="statinfo" string="Sales"/>
						</button>
						<button name="action_view_sells_r" type="object" class="oe_stat_button" icon="fa-reply"
							attrs="{'invisible': [('sells_r_count', '=', 0)]}">
							<field name="sells_r_count" widget="statinfo" string="Return Sales"/>
						</button>
						<button name="action_view_customers_in" type="object" class="oe_stat_button" icon="fa-arrow-down"
							attrs="{'invisible': [('customers_in_count', '=', 0)]}">
							<field name="customers_in_count" widget="statinfo" string="Payments In"/>
						</button>
						<button name="action_view_customers_out" type="object" class="oe_stat_button" icon="fa-arrow-up"
							attrs="{'invisible': [('customers_out_count', '=', 0)]}">
							<field name="customers_out_count" widget="statinfo" string="Payments Out"/>
						</button>
					</div>
					<div class="oe_title">
						<h1><field name="name" placeholder="Customer Name"/></h1>
					</div>
					<group name="basic_info">
						<group string="Basic Info">
							<field name="fld_star_name"/>
							<field name="fld_phone"/>
						</group>
						<group string="Address">
							<field name="fld_address"/>
							<field name="active" invisible="1"/>
						</group>
					</group>
					<group name="notes" string="Notes">
						<field name="fld_notes" nolabel="1" placeholder="Add notes about this customer..."/>
					</group>
					<notebook>
						<page string="Sales Restrictions" name="restrictions">
							<group name="restriction_info">
								<group string="Restriction Settings">
									<field name="has_restriction" widget="boolean_toggle" attrs="{'readonly':[('restriction_amount', '&gt;', 0)]}"/>
									<field name="restriction_amount" widget="monetary" placeholder="0.00"/>
								</group>
								<group string="Balance Information">
									<field name="balance" widget="monetary" groups="super_market_pro.super_market_manager_group"/>
								</group>
							</group>
							<div name="restriction_status" string="Restriction Status">
								<div class="alert alert-info" attrs="{'invisible':[('has_restriction', '=', False)]}">
									<strong>Customer is restricted from sales</strong><br/>
								</div>
								<div class="alert alert-success" attrs="{'invisible':[('has_restriction', '=', True)]}">
									<strong>Customer has no sales restrictions</strong><br/>
									Can proceed with normal sales transactions
								</div>
							</div>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<record model="ir.actions.act_window" id="customers_action_id">
        <field name="name">Customers</field>
        <field name="res_model">mdl_customers</field>
        <field name="view_mode">tree,form</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">Create your first customer!</p>
			<p>Customers are companies or individuals you sell products to.</p>
		</field>
    </record>
</odoo>
