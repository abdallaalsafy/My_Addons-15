<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Search View -->
    <record model="ir.ui.view" id="spending_search_id">
        <field name="name">Spending Search</field>
        <field name="model">mdl_spending</field>
        <field name="arch" type="xml">
            <search string="Search Spending">
                <!-- Search Fields -->
                <field name="name"/>
                <field name="fld_date"/>
                <field name="fld_catg_id"/>
                <field name="fld_notes"/>
                <!-- Filters -->
                <separator/>
                <filter string="Today" name="created_today" domain="[('create_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="created_this_week" domain="[('create_date', '>=', (context_today()+datetime.timedelta(-6)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="created_this_month" domain="[('create_date', '>=', context_today().replace(day=1).strftime('%Y-%m-%d'))]"/>
                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter string="Date" name="group_date" context="{'group_by':'fld_date'}"/>
                    <filter string="Category" name="group_catg" context="{'group_by':'fld_catg_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tree View -->
    <record model="ir.ui.view" id="spending_list_id">
        <field name="name">Spending List</field>
        <field name="model">mdl_spending</field>
        <field name="arch" type="xml">
            <tree decoration-bf="1">
                <field name="name"/>
                <field name="fld_date" widget="date"/>
                <field name="fld_catg_id"/>
                <field name="fld_paying" widget="monetary" sum="Total Spending"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record model="ir.ui.view" id="spending_form_id">
        <field name="name">Spending Form</field>
        <field name="model">mdl_spending</field>
        <field name="arch" type="xml">
            <form string="Spending">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    
                    <group>
                        <group name="basic_info">
                            <field name="fld_date" options="{'datepicker':{'maxDate': 'now'}}"/>
                            <field name="fld_paying" widget="monetary" placeholder="0.00"/>
                        </group>
                        <group name="category_info">
                            <field name="fld_catg_id"/>
                            <field name="fld_notes" placeholder="Enter spending notes..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action Window -->
    <record model="ir.actions.act_window" id="spending_action_id">
        <field name="name">Spending</field>
        <field name="res_model">mdl_spending</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first spending record
            </p>
            <p>
                Manage daily expenses, track spending by category, and maintain accurate financial records.
            </p>
        </field>
    </record>
</odoo>
