<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record model="ir.ui.view" id="categorys_search_id">
		<field name="name">Categorys_Search</field>
		<field name="model">mdl_categorys</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>
				<field name="fld_description"/>
			</search>
		</field>
	</record>

	<record model="ir.ui.view" id="categorys_list_id">
		<field name="name">Categorys_List</field>
		<field name="model">mdl_categorys</field>
		<field name="arch" type="xml">
			<tree decoration-bf='1'>
				<field name="name"/>
				<field name="fld_description"/>
			</tree>
		</field>
	</record>

	<record model="ir.ui.view" id="categorys_form_id">
		<field name="name">Categorys_Form</field>
		<field name="model">mdl_categorys</field>
		<field name="arch" type="xml">
			<form>
				<header></header>
				<sheet>
					<div class="oe_title">
						<h1>
							<field name="name" placeholder="Category Name..."/>
						</h1>
					</div>
					<group string="Description">
						<field name="fld_description" nolabel="1" placeholder="Add category description here..."/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

    <record model="ir.actions.act_window" id="categorys_action_id">
        <field name="name">Categorys_Action</field>
        <field name="res_model">mdl_categorys</field>
		<field name="view_mode">tree,form</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">Creat The First Category</p>
		</field>
    </record>
</odoo>