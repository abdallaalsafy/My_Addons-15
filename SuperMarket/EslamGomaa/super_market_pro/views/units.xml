<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="units_search_id" model="ir.ui.view">
        <field name="name">Units Search</field>
        <field name="model">mdl_units</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Unit" filter_domain="[('name', 'ilike', self)]"/>
                <field name="fld_catg_id"/>
                <separator/>
                <filter string="Reference Units" name="ref_units" domain="[('fld_type', '=', 'ref')]"/>
                <filter string="Bigger Units" name="big_units" domain="[('fld_type', '=', 'big')]"/>
                <filter string="Smaller Units" name="small_units" domain="[('fld_type', '=', 'smll')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_by_category" context="{'group_by': 'fld_catg_id'}"/>
                    <filter string="Type" name="group_by_type" context="{'group_by': 'fld_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="units_list_id" model="ir.ui.view">
        <field name="name">Units List</field>
        <field name="model">mdl_units</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="fld_catg_id"/>
                <field name="fld_type" widget="badge" decoration-success="fld_type == 'ref'" decoration-info="fld_type != 'ref'"/>
                <field name="fld_ratio"/>
            </tree>
        </field>
    </record>

	<record id="units_form_id" model="ir.ui.view">
        <field name="name">Units Form</field>
        <field name="model">mdl_units</field>
        <field name="arch" type="xml">
            <form>
                <field name="fld_factor" invisible="1"/>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Unit Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="fld_catg_id" required="1"/>
                            <field name="fld_type" required="1"/>
                            <field name="fld_ratio" attrs="{'readonly': [('fld_type', '=', 'ref')]}"/>
                        </group>
                        <group invisible="1">
                            <field name="active" />
                            <field name="color"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="fld_description" nolabel="1" placeholder="Add description here..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="units_action_id" model="ir.actions.act_window">
        <field name="name">Units Action</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mdl_units</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Add a new unit of measure
          </p>
        </field>
    </record>
</odoo>