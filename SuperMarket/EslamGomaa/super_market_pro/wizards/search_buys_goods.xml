<odoo>
    <record model="ir.ui.view" id="search_buys_goods_form_id">
        <field name="name">Search Buys Goods Form</field>
        <field name="model">wzrd_search_buys_goods</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Search Buys Goods">
                <group string="Elements Search">
                    <field name="fld_transaction_type"/>
                    <field name="fld_vendor_id" attrs="{'invisible':[('fld_transaction_type','not in',['buys','buys_r'])]}"/>
                    <field name="fld_customer_id" attrs="{'invisible':[('fld_transaction_type','not in',['sells','sells_r'])]}"/>
                    <field name="fld_category_id"/>
                    <field name="fld_goods_id"/>
                    <field name="fld_date_f" attrs="{'readonly':[('fld_date_selc','!=',False)]}"
                                                options="{'datepicker':{'maxDate': 'now'}}"/>
                    <field name="fld_date_t" attrs="{'readonly':[('fld_date_selc','!=',False)]}"
                                                options="{'datepicker':{'maxDate': 'now'}}"/>
                    <field name="fld_date_selc" attrs="{'readonly':['|',('fld_date_f','!=',False),('fld_date_t','!=',False)]}"/>
                </group>
                <footer>
                    <button name="fnc_do_action" string="OK" type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="search_buys_goods_action_id">
		<field name="name">Search Buys Goods Action</field>
		<field name="res_model">wzrd_search_buys_goods</field>
		<field name="view_mode">form</field>
		<field name="target" >new</field>
	</record>
</odoo>