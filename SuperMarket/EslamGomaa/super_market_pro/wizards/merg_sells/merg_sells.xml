<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="merg_sells_form_id">
		<field name="name">Merg_Sells_Form</field>
		<field name="model">wzrd_merg_sells</field>
		<field name="arch" type="xml">
			<form string="Merge Sales Orders">
                <p>** Read Notes First **</p>
                <p>(1) If There Is More Than One Customers , Will Take First One</p>
                <p>(2) It Will Take Data Of The Oldest Sells With Date</p>
                <p>(3) After Mergining Will Delete Other Sells</p>
                <group name="merge_options" string="Merge Options">
                    <field name="merge_date"/>
                    <field name="merge_notes" placeholder="Optional notes about this merge operation..."/>
                </group>
				<footer>
					<button name='fnc_merging_sells' string='Merge Orders' type='object' class="btn-primary"/>
					<button special="cancel" string="Cancel" class="btn-secondary"/>
				</footer>
			</form>
		</field>
	</record>

    <record model="ir.actions.act_window" id="merg_sells_action_id">
		<field name="name">Merg_Sells_Action</field>
		<field name="res_model">wzrd_merg_sells</field>
		<field name="view_mode">form</field>
		<field name="target" >new</field>
		<field name="view_id" ref="merg_sells_form_id"/>
		<field name="binding_model_id"    ref="model_mdl_sells"/>
		<field name="binding_view_types">list</field>
	</record>
</odoo>