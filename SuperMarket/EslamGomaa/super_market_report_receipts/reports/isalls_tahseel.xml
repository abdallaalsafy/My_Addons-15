<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
        <template id="isalls_tahseel_inherit_template_id" name="" inherit_id="super_market_installments.isalls_tahseel_template_id" priority="30">
            <xpath expr="//t[@t-foreach='docs' and @t-as='o']" position="replace">
                <t t-set="xNum" t-value="0"/>
                <t t-foreach="docs" t-as="o">
                    <t t-set="xNum" t-value="xNum+1"/>
                    <div style="padding:0px;margin:0px; position:relative;">
                        <img src="/super_market_report_receipts/static/description/isal_1.png" alt="Logo"
                             style="height: 462px;width: 1000px;padding:0px;margin:0px;"/>

                            <div style="text-align:center; font-size:25px; position:absolute;
                                top:40px;right:80px; width:40px; overflow:hidden;">
                                 <span t-field="o.fld_num"/>
                            </div>
                             <div style="text-align:center; font-size:25px; position:absolute;
                                top:50px;right:5px; width:45px; overflow:hidden;">
                                 <span t-field="o.fld_num_isalls"/>
                            </div>
                            <div style="text-align:right; font-size:25px;top:10px;position:absolute;
                                top:105px;right:160px; width:500px; overflow:hidden;">
                                 <span t-field="o.fld_customer_id.name"/>
                            </div>
                            <div style="text-align:right; font-size:23px; position:absolute;
                                top:135px;right:160px; width:285px; overflow:hidden;">
                                 <span t-field="o.fld_region_id.name"/>
                                <span>/</span>
                                 <span t-field="o.fld_place_id.name"/>
                            </div>
                            <div style="text-align:right; font-size:25px; position:absolute;
                                top:135px;right:500px;">
                                 <span t-field="o.fld_phone"/>
                            </div>
                            <div style="text-align:center; font-size:25px; position:absolute;
                                top:170px;right:375px; width:110px; overflow:hidden;">
                                 <span t-esc="round(o.fld_amount)"/>
                            </div>
                            <div style="text-align:center; font-size:20px; position:absolute;
                                top:200px;right:700px; width:70px; overflow:hidden;">
                                 <span t-esc="round(o.fld_sell_id.fld_paying)"/>
                            </div>
                            <div style="text-align:right; font-size:20px; position:absolute;
                                top:183px;right:780px; width:180px; overflow:hidden;">
                                <span t-field="o.fld_sell_id.fld_sells_goods_ids[0].fld_goods_id.name"/>
                            </div>
                            <t t-if="len(o.fld_sell_id.fld_sells_goods_ids) > 1">
                                <div style="text-align:right; font-size:20px; position:absolute;
                                    top:215px;right:780px; width:180px; overflow:hidden;">
                                    <span>ومنتجات آخرى ...</span>
                                </div>
                            </t>
                            <div style="text-align:right; font-size:18px; position:absolute;
                                top:215px;right:130px; width:100px; overflow:hidden;">
                                 <span t-field="o.fld_reg_date"/>
                            </div>
                             <div style="text-align:right; font-size:18px; position:absolute;
                                top:290px;right:117px; width:100px; overflow:hidden;">
                                 <span t-field="o.fld_sell_id.fld_date"/>
                            </div>
                            <div style="text-align:right; font-size:18px; position:absolute;
                                top:330px;right:117px; width:175px; overflow:hidden;">
                                <t t-if="len(o.fld_mandoops) > 0">
                                    <span t-field="o.fld_mandoops[0].name"/>
                                </t>
                            </div>
                            <div style="text-align:right; font-size:18px; position:absolute;
                                top:360px;right:117px; width:175px; overflow:hidden;">
                                 <t t-if="len(o.fld_mandoops) > 1">
                                    <span t-field="o.fld_mandoops[1].name"/>
                                </t>
                            </div>
                            <div style="text-align:right; font-size:18px; position:absolute;
                                top:390px;right:117px; width:175px; overflow:hidden;">
                                 <t t-if="len(o.fld_mandoops) > 2">
                                    <span t-field="o.fld_mandoops[2].name"/>
                                </t>
                            </div>

                    </div>
                    <div t-if="xNum % 3 != 0" style="padding:0px;margin:0px;">
                        <span>------------------------------------------------------------------------------------------------------------------------</span>
                    </div>
                </t>
        </xpath>
    </template>
	</data>
</odoo>