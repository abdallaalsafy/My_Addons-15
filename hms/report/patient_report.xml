<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
        <record id="patient_paperformat_id" model="report.paperformat">
            <field name="name">Patient Paper Format</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">2</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">2</field>
            <field name="margin_right">2</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">20</field>
            <field name="dpi">90</field>
        </record>

        <record id="patient_action_report_id" model="ir.actions.report">
            <field name="name">Patient Action Report</field>
            <field name="model">hms.patient</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hms.patient_template_id</field>
            <field name="report_file">hms.reports.patient_template_id</field>
            <field name="print_report_name">'Patient Report'</field>
            <field name="binding_model_id" ref="model_hms_patient"/>
            <field name="paperformat_id" ref="hms.patient_paperformat_id"/>
            <field name="binding_view_types">list,form</field>
            <field name="binding_type">report</field>
        </record>
<!--ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc-->
        <template id="patient_template_id">
            <t   t-call = "web.html_container">
                <t  t-foreach="docs"    t-as="doc">
                    <t   t-call="web.external_layout">
                        <style>
                            *{font-family: Arial, sans-serif;}
                            .fsize{font-size:20px;}
                            .pmargin{margin-bottom:0px;}
                            tbody tr:nth-child(even) {background-color: #eef2ff; }
                            tbody tr:nth-child(odd) {background-color: #c8d8ff; }
                            th{background-color:blue;color:white;}
                        </style>
                        <div class="page" style="outline: 1px solid blue;padding:25px;">
                            <div class="row" style="margin-bottom:20px;">
                                <h1 class="col-8" style="color:red;padding-top:50px;"><b>Patient Status Report</b></h1>
                                <div class="col-4">
                                    <img  t-att-src = "image_data_uri(doc.img)" t-if = "doc.img" height="150" width="150"/>
                                </div>
                            </div>
                            <div class="row fsize">
                                <p class="col-6 pmargin">
                                    <b>Name:</b>
                                    <span t-field="doc.name"/>
                                    <span t-field="doc.last_name"/>
                                </p>
                                <p class="col-6 pmargin"><b>Birth Date:</b>
                                    <span t-field="doc.birth_date"/>
                                </p>
                            </div>
                            <div class="row fsize">
                                <p class="col-6 pmargin"><b>Age:</b>
                                    <span t-field="doc.age"/>
                                </p>
                                <p class="col-6 pmargin"><b>PCR:</b>
                                    <span t-field="doc.cr_ratio"/>
                                </p>
                            </div>
                            <div class="row fsize">
                                <p class="col-6 pmargin"><b>Department:</b>
                                    <span t-field="doc.department_id.name"/>
                                </p>
                                <p class="col-6 pmargin"><b>Blood Type:</b>
                                    <span t-field="doc.blood_type"/>
                                </p>
                            </div>
                            <div class="row fsize">
                                <p class="col-6 pmargin"><b>Doctors:</b>
                                    <t  t-foreach="doc.doctor_ids" t-as="doctor">
                                        <span t-field="doctor.name"/>,
                                    </t>
                                </p>
                                <p class="col-6 pmargin"><b>Email:</b>
                                    <span t-field="doc.email"/>
                                </p>
                            </div>
                            <p style="text-align:center;color:red;font-size:30px;margin-top:20px;"><b>Log History</b></p>
                            <div style="width:80%;margin-left:10%;margin-right:10%;">
                                <p t-field="doc.history" />
                            </div>

                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>