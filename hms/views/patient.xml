<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="patient_form_id" model="ir.ui.view">
            <field name="name">Patient Form</field>
            <field name="model">hms.patient</field>
            <field name="arch" type="xml">
                <form>
                    <field name="img" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="abdalla"/></h1>
                        <label for="last_name" string="Last Name"/>
                        <h2><field name="last_name" placeholder="alsafy"/></h2>
                        <label for="email" string="Email"/>
                        <h2><field name="email" placeholder="abdallaalsafy@gmail.com" widget="email"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="blood_type"/>
                            <field name="cr_ratio" attrs="{'required':[('pcr', '=', True)]}"/>
                            <field name="pcr"/>

                        </group>
                        <group>
                            <field name="state"/>
                            <field name="department_id"/>
                            <field name="capacity"/>
                            <field name="doctor_ids"
                                   widget="many2many_tags"
                                    attrs="{'readonly':[('department_id', '=', False)]}"
                                    groups="hms.managers_group_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="address"/>
                        <field name="history" attrs="{'invisible':[('age', '&lt;', 50)]}"/>
                    </group>
                </form>
            </field>
        </record>
        <record id="patient_action_id" model="ir.actions.act_window">
            <field name="name">Patient Action</field>
            <field name="res_model">hms.patient</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>