<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Company Financial Summary Form View -->
        <record id="view_company_financial_summary_form" model="ir.ui.view">
            <field name="name">company.financial.summary.form</field>
            <field name="model">company.financial.summary</field>
            <field name="arch" type="xml">
                <form string="Company Financial Summary">
                    <field name="company_currency" invisible="1"/>
                    <sheet>
                        <div class="oe_title">
                            <h1>Company Financial Summary</h1>
                            <field name="date_from" invisible="1"/>
                        </div>
                        
                        <notebook>
                            <page string="Actual Liquidity">
                                <group>
                                    <group>
                                        <field name="actual_liquidity" style="font-weight: bold;font-size: 16px;"/>
                                    </group>
                                    <group string="Calculation elements">
                                        <field name="positive_transactions"/>
                                        <field name="sales_paid_amount"/>
                                        <field name="negative_transactions" style="color: red;"/>
                                        <field name="expenses_paid_amount" style="color: red;"/>
                                        <field name="purchases_paid_amount" style="color: red;"/>
                                    </group>
                                </group>
                                <div class="alert alert-info" role="alert">
                                    <p><strong>Note:</strong> The actual liquidity represents the current balance of the company's assets and liabilities.</p>
                                    <p><strong>It consists of:</strong></p>
                                    <ul>
                                        <li><b>1 Positive Transactions:</b></li>
                                        <li><b>2 Sale Paid:</b></li>
                                        <li><b>Minus</b></li>
                                        <li><b>3 Negative Transactions:</b></li>
                                        <li><b>4 Expense Paid:</b></li>
                                        <li><b>5 Purchase Paid:</b></li>
                                    </ul>
                                </div>
                            </page>

                            <page string="Investments Statistics">
                                <group>
                                    <group string="Overview">
                                        <field name="investments_count"/>
                                        <field name="investments_open_count"/>
                                        <field name="investments_closed_count"/>
                                    </group>
                                    <group string="Financial Summary">
                                        <field name="investments_total_amount"/>
                                        <field name="investments_open_amount"/>
                                        <field name="investments_closed_amount"/>
                                    </group>
                                </group>
                                <group>
                                    <group string="Partnership Statistics">
                                        <field name="Partnership_partners_count" />
                                    </group>
                                    <group string="Investments Amounts"> 
                                        <field name="investments_maximum_amount"/>
                                        <field name="investments_minimum_amount"/>
                                         <field name="partnerships_debtor_amount"/>
                                    </group>
                                </group>
                            </page>
                            
                            <page string="Partners Statistics">
                                <group>
                                    <group string="Overview">
                                        <field name="partners_count"/>
                                        <field name="partners_active_count"/>
                                        <field name="partners_exited_count"/>
                                        <field name="partners_debtor_count"/>
                                    </group>
                                    <group string="Financial Summary">
                                        <field name="partners_current_balance"/>
                                        <field name="partners_maximum_balance"/>
                                        <field name="partners_minimum_balance"/>
                                        <field name="partners_debtor_balance" style="color: red;"/>
                                    </group>
                                </group>
                            </page>
                            
                            <page string="Purchases Statistics">
                                <group>
                                    <group string="Overview">
                                        <field name="purchases_count"/>
                                        <field name="purchases_paid_count"/>
                                        <field name="purchases_unpaid_count"/>
                                    </group>
                                    <group string="Financial Summary">
                                        <field name="purchases_total_price"/>
                                        <field name="purchases_paid_amount"/>
                                        <field name="purchases_unpaid_amount"/>
                                    </group>
                                </group>
                            </page>
                            
                            <page string="Sales Statistics">
                                <group>
                                    <group string="Overview">
                                        <field name="sales_count"/>
                                        <field name="sales_paid_count"/>
                                        <field name="sales_unpaid_count"/>
                                    </group>
                                    <group string="Financial Summary">
                                        <field name="sales_total_price"/>
                                        <field name="sales_paid_amount"/>
                                        <field name="sales_unpaid_amount"/>
                                    </group>
                                </group>
                                <group>
                                    <group string="Profits">
                                        <field name="sales_total_profit"/>
                                        <field name="sales_total_management_fees"/>
                                        <field name="sales_total_net_profit"/>
                                    </group>
                                    <group></group>
                                </group>
                            </page>
                            
                            <page string="Expenses Statistics">
                                <group string="All Expenses">
                                    <group>
                                        <field name="expenses_count"/>
                                        <field name="expenses_paid_count"/>
                                        <field name="expenses_unpaid_count"/>
                                    </group>
                                    <group>
                                        <field name="expenses_total_amount"/>
                                        <field name="expenses_paid_amount"/>
                                        <field name="expenses_unpaid_amount" style="color: red;"/>
                                    </group>
                                </group>
                                <group string="Investment Expenses Payment Status">
                                    <group>
                                        <field name="expenses_investment_count"/>
                                        <field name="expenses_investment_paid_count"/>
                                        <field name="expenses_investment_unpaid_count"/>
                                    </group>
                                    <group>
                                        <field name="expenses_investment_amount"/>
                                        <field name="expenses_investment_paid_amount"/>
                                        <field name="expenses_investment_unpaid_amount" style="color: red;"/>
                                    </group>
                                </group>
                                <group string="Company Expenses Payment Status">
                                    <group>
                                        <field name="expenses_company_count"/>
                                        <field name="expenses_company_paid_count"/>
                                        <field name="expenses_company_unpaid_count"/>
                                    </group>
                                    <group>
                                        <field name="expenses_company_amount"/>
                                        <field name="expenses_company_paid_amount"/>
                                        <field name="expenses_company_unpaid_amount" style="color: red;"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button name="action_print_report" string="Print Report" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        
        <!-- Action for Company Financial Summary -->
        <record id="action_company_financial_summary" model="ir.actions.act_window">
            <field name="name">Company Financial Summary</field>
            <field name="res_model">company.financial.summary</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
