#: model_terms:ir.ui.view,arch_db:real_estate_partnership_management.view_company_financial_summary_form
msgid ""
"<b>1 Partners Actual Balance:</b> The current positive balance in the "
"partners' accounts"
msgstr "<b>1 الرصيد الفعلي للشركاء:</b> الرصيد الموجب الحالي في حسابات الشركاء"

