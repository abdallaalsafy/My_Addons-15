<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Management Fee Summary Tree View -->
        <record id="view_management_fee_summary_tree" model="ir.ui.view">
            <field name="name">real.estate.management.fee.summary.tree</field>
            <field name="model">real.estate.management.fee.summary</field>
            <field name="arch" type="xml">
                <tree string="Management Fees Summary" create="0" delete="0">
                    <field name="fee_type"/>
                    <field name="reference"/>
                    <field name="date"/>
                    <field name="property_code"/>
                    <field name="property_name"/>
                    <field name="buyer_name" optional="hide"/>
                    <field name="total_profit" widget="monetary" sum="Total Profit"/>
                    <field name="management_fee_percentage"/>
                    <field name="management_fee_amount" widget="monetary" sum="Total Management Fees"/>
                    <field name="net_profit" widget="monetary" sum="Net Profit"/>
                </tree>
            </field>
        </record>

        <!-- Management Fee Summary Server Action to Load Data -->
        <record id="action_load_management_fees" model="ir.actions.server">
            <field name="name">Load Management Fees</field>
            <field name="model_id" ref="model_real_estate_management_fee_summary"/>
            <field name="state">code</field>
            <field name="code">
                action = model.load_management_fees()
            </field>
        </record>
    </data>
</odoo>
