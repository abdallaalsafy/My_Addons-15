<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
            <!-- Sequences -->
        <record id="seq_real_estate_partner" model="ir.sequence">
            <field name="name">Real Estate Partner</field>
            <field name="code">real.estate.partner</field>
            <field name="prefix">REP</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

