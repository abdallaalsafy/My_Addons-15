<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- QWeb report template for Transaction List -->
        <template id="report_transaction_list">
            <t t-call="web.external_layout">
                <style>
                    body { direction: rtl; text-align: right; }
                    .page { direction: rtl; }
                    table { direction: rtl; }
                    .report-title { margin-bottom: 20px; }
                    .header-label { font-weight: bold; padding-right: 10px; }
                    .transaction-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-top: 20px;
                        border: 1px solid #999;
                    }
                    .transaction-table thead {
                        background-color: #2d5016;
                        color: white;
                    }
                    .transaction-table thead th {
                        border: 1px solid #1e3410;
                        padding: 10px 5px;
                        font-weight: bold;
                        text-align: right;
                        color: white;
                    }
                    .transaction-table tbody td {
                        border: 1px solid #ddd;
                        padding: 8px 5px;
                        text-align: right;
                    }
                    .transaction-table tbody tr:nth-child(even) {
                        background-color: #f9f9f9;
                    }
                    .text-right { text-align: right; }
                    .text-center { text-align: center; }
                </style>
                <main>
                <div class="page">
                    <h2 style="text-align: center;">Partner Transactions List Report</h2>

                    <table class="transaction-table">
                        <thead>
                            <tr>
                                <th style="width: 5%;">No.</th>
                                <th>Description</th>
                                <th>Payment Reference</th>
                                <th>Payment Method</th>
                                <th>Amount</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Partner</th>
                                <th>Reference</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="docs">
                                <t t-foreach="docs" t-as="trans">
                                    <tr>
                                        <td><span t-esc="trans_index + 1"/></td>
                                        <td><span t-field="trans.description"/></td>
                                        <td><span t-field="trans.payment_reference"/></td>
                                        <td><span t-field="trans.payment_method"/></td>
                                        <td><span t-esc="'{:,.2f}'.format(trans.amount)"/></td>
                                        <td><span t-field="trans.transaction_type"/></td>
                                        <td><span t-field="trans.transaction_date"/></td>
                                        <td><span t-field="trans.partner_id.name"/></td>
                                        <td><span t-field="trans.name"/></td>
                                    </tr>
                                </t>
                            </t>
                            <t t-if="not docs">
                                <tr>
                                    <td colspan="9" class="text-center">No transactions found.</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                </div>
                </main>
            </t>
        </template>

        <!-- Report action -->
        <record id="report_transaction_list_action" model="ir.actions.report">
            <field name="name">Transactions List</field>
            <field name="model">real.estate.transaction</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">real_estate_partnership_management.report_transaction_list</field>
            <field name="report_file">real_estate_partnership_management.report_transaction_list</field>
            <field name="binding_model_id" ref="model_real_estate_transaction"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_landscape"/>
        </record>
    </data>
</odoo>
