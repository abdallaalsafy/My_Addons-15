<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- QWeb report template for Investment Payment List -->
        <template id="report_investment_payment_list">
            <t t-call="web.external_layout">
                <style>
                    body { direction: rtl; text-align: right; }
                    .page { direction: rtl; }
                    table { direction: rtl; }
                    .report-title { margin-bottom: 20px; }
                    .header-label { font-weight: bold; padding-right: 10px; }
                    .payment-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-top: 20px;
                        border: 1px solid #999;
                    }
                    .payment-table thead {
                        background-color: #2d5016;
                        color: white;
                    }
                    .payment-table thead th {
                        border: 1px solid #1e3410;
                        padding: 10px 5px;
                        font-weight: bold;
                        text-align: right;
                        color: white;
                    }
                    .payment-table tbody td {
                        border: 1px solid #ddd;
                        padding: 8px 5px;
                        text-align: right;
                    }
                    .payment-table tbody tr:nth-child(even) {
                        background-color: #f9f9f9;
                    }
                    .text-right { text-align: right; }
                    .text-center { text-align: center; }
                </style>
                <main>
                <div class="page">
                    <h2 style="text-align: center;">Investment Payment List</h2>

                    <table class="payment-table">
                        <thead>
                            <tr>
                                <th style="width: 5%;">No.</th>
                                <th>Notes</th>
                                <th>Payment Date</th>
                                <th>Amount</th>
                                <th>Partner</th>
                                <th>Investment</th>
                                <th>Reference</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="docs">
                                <t t-foreach="docs" t-as="pay">
                                    <tr>
                                        <td><span t-esc="pay_index + 1"/></td>
                                        <td><span t-field="pay.notes"/></td>
                                        <td><span t-field="pay.payment_date"/></td>
                                        <td><span t-esc="'{:,.2f}'.format(pay.amount)"/></td>
                                        <td><span t-field="pay.partner_id.name"/></td>
                                        <td><span t-field="pay.investment_id.name"/></td>
                                        <td><span t-field="pay.name"/></td>
                                    </tr>
                                </t>
                            </t>
                            <t t-if="not docs">
                                <tr>
                                    <td colspan="7" class="text-center">No payments found.</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                </div>
                </main>
            </t>
        </template>

        <!-- Report action -->
        <record id="report_investment_payment_list_action" model="ir.actions.report">
            <field name="name">Investment Payment List</field>
            <field name="model">real.estate.investment.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">real_estate_partnership_management.report_investment_payment_list</field>
            <field name="report_file">real_estate_partnership_management.report_investment_payment_list</field>
            <field name="binding_model_id" ref="model_real_estate_investment_payment"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_landscape"/>
        </record>
    </data>
</odoo>
