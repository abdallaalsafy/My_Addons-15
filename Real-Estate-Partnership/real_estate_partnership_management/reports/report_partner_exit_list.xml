<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- QWeb report template for Partner Exit List -->
        <template id="report_partner_exit_list">
            <t t-call="web.external_layout">
                <style>
                    body { direction: rtl; text-align: right; }
                    .page { direction: rtl; }
                    table { direction: rtl; }
                    .report-title { margin-bottom: 20px; }
                    .header-label { font-weight: bold; padding-right: 10px; }
                    .exit-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-top: 20px;
                        border: 1px solid #999;
                    }
                    .exit-table thead {
                        background-color: #2d5016;
                        color: white;
                    }
                    .exit-table thead th {
                        border: 1px solid #1e3410;
                        padding: 10px 5px;
                        font-weight: bold;
                        text-align: right;
                        color: white;
                    }
                    .exit-table tbody td {
                        border: 1px solid #ddd;
                        padding: 8px 5px;
                        text-align: right;
                    }
                    .exit-table tbody tr:nth-child(even) {
                        background-color: #f9f9f9;
                    }
                    .text-right { text-align: right; }
                    .text-center { text-align: center; }
                </style>
                <main>
                <div class="page">
                    <h2 style="text-align: center;">Partner Exit List</h2>

                    <table class="exit-table">
                        <thead>
                            <tr>
                                <th style="width: 5%;">No.</th>
                                <th>Notes</th>
                                <th>Management Fee %</th>
                                <th>Net Profit</th>
                                <th>Management Fee Amount</th>
                                <th>Actual Profit</th>
                                <th>Total Cost</th>
                                <th>Current Value</th>
                                <th>Exit Date</th>
                                <th>Property</th>
                                <th>Reference</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="docs">
                                <t t-foreach="docs" t-as="exit">
                                    <tr>
                                        <td><span t-esc="exit_index + 1"/></td>
                                        <td><span t-field="exit.notes"/></td>
                                        <td><span t-esc="'{:.2f}%'.format(exit.management_fee_percentage)"/></td>
                                        <td><span t-esc="'{:,.2f}'.format(exit.net_profit)"/></td>
                                        <td><span t-esc="'{:,.2f}'.format(exit.management_fee_amount)"/></td>
                                        <td><span t-esc="'{:,.2f}'.format(exit.actual_property_profit)"/></td>
                                        <td><span t-esc="'{:,.2f}'.format(exit.total_property_cost)"/></td>
                                        <td><span t-esc="'{:,.2f}'.format(exit.current_property_value)"/></td>
                                        <td><span t-field="exit.exit_date"/></td>
                                        <td><span t-field="exit.property_id.name"/></td>
                                        <td><span t-field="exit.name"/></td>
                                    </tr>
                                </t>
                            </t>
                            <t t-if="not docs">
                                <tr>
                                    <td colspan="11" class="text-center">No exit records found.</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                </div>
                </main>
            </t>
        </template>

        <!-- Report action -->
        <record id="report_partner_exit_list_action" model="ir.actions.report">
            <field name="name">Partner Exit List</field>
            <field name="model">real.estate.partner.exit</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">real_estate_partnership_management.report_partner_exit_list</field>
            <field name="report_file">real_estate_partnership_management.report_partner_exit_list</field>
            <field name="binding_model_id" ref="model_real_estate_partner_exit"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_landscape"/>
        </record>
    </data>
</odoo>
