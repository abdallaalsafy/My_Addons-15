<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- QWeb report template for Investment List -->
        <template id="report_investment_list">
            <t t-call="web.external_layout">
                <style>
                    body { direction: rtl; text-align: right; }
                    .page { direction: rtl; }
                    table { direction: rtl; }
                    .report-title { margin-bottom: 20px; }
                    .header-label { font-weight: bold; padding-right: 10px; }
                    .investment-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-top: 20px;
                        border: 1px solid #999;
                    }
                    .investment-table thead {
                        background-color: #2d5016;
                        color: white;
                    }
                    .investment-table thead th {
                        border: 1px solid #1e3410;
                        padding: 10px 5px;
                        font-weight: bold;
                        text-align: right;
                        color: white;
                    }
                    .investment-table tbody td {
                        border: 1px solid #ddd;
                        padding: 8px 5px;
                        text-align: right;
                    }
                    .investment-table tbody tr:nth-child(even) {
                        background-color: #f9f9f9;
                    }
                    .text-right { text-align: right; }
                    .text-center { text-align: center; }
                </style>
                <main>
                <div class="page">
                    <h2 style="text-align: center;">Investments List Report</h2>

                    <table class="investment-table">
                        <thead>
                            <tr>
                                <th style="width: 5%;">No.</th>
                                <th>Notes</th>
                                <th>Withdrawal Date</th>
                                <th>Withdrawal Reason</th>
                                <th>Status</th>
                                <th>Input Percentage</th>
                                <th>Percentage</th>
                                <th>Total Amount</th>
                                <th>Total Cost</th>
                                <th>Investment Date</th>
                                <th>Property</th>
                                <th>Partner</th>
                                <th>Reference</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="docs">
                                <t t-foreach="docs" t-as="inv">
                                    <tr>
                                        <td><span t-esc="inv_index + 1"/></td>
                                        <td><span t-field="inv.notes"/></td>
                                        <td><span t-field="inv.withdrawal_date"/></td>
                                        <td><span t-field="inv.withdrawal_ref"/></td>
                                        <td><span t-field="inv.status"/></td>
                                        <td><span t-esc="'{:.2f}%'.format(inv.input_percentage)"/></td>
                                        <td><span t-esc="'{:.2f}%'.format(inv.percentage)"/></td>
                                        <td><span t-esc="'{:,.2f}'.format(inv.amount)"/></td>
                                        <td><span t-esc="'{:,.2f}'.format(inv.total_cost)"/></td>
                                        <td><span t-field="inv.investment_date"/></td>
                                        <td><span t-field="inv.property_id.name"/></td>
                                        <td><span t-field="inv.partner_id.name"/></td>
                                        <td><span t-field="inv.name"/></td>
                                    </tr>
                                </t>
                            </t>
                            <t t-if="not docs">
                                <tr>
                                    <td colspan="13" class="text-center">No investments found.</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                </div>
                </main>
            </t>
        </template>

        <!-- Report action -->
        <record id="report_investment_list_action" model="ir.actions.report">
            <field name="name">Investments List</field>
            <field name="model">real.estate.property.investment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">real_estate_partnership_management.report_investment_list</field>
            <field name="report_file">real_estate_partnership_management.report_investment_list</field>
            <field name="binding_model_id" ref="model_real_estate_property_investment"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_landscape"/>
        </record>
    </data>
</odoo>
