<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Res Config Settings Form View -->
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block" data-string="Real Estate" string="Real Estate" data-key="real_estate">
                        <h2>Real Estate Investment Settings</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="restrict_sale_on_low_balance"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="restrict_sale_on_low_balance"/>
                                    <div class="text-muted">
                                        If enabled, property sale will be restricted when any partner has balance less than their investment amount.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
