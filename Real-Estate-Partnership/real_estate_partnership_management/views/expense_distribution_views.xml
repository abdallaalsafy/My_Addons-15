<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Expense Distribution Tree View -->
        <record id="view_real_estate_expense_distribution_tree" model="ir.ui.view">
            <field name="name">real.estate.expense.distribution.tree</field>
            <field name="model">real.estate.expense.distribution</field>
            <field name="arch" type="xml">
                <tree string="Expense Distributions" create="0" edit="0" delete="0">
                    <field name="expense_id"/>
                    <field name="partner_id"/>
                    <field name="distribution_method"/>
                    <field name="partner_share" widget="monetary" sum="Total Share"/>
                    <field name="share_percentage" widget="percentage"/>
                    <field name="distribution_date"/>
                    <field name="status" widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- Expense Distribution Form View -->
        <record id="view_real_estate_expense_distribution_form" model="ir.ui.view">
            <field name="name">real.estate.expense.distribution.form</field>
            <field name="model">real.estate.expense.distribution</field>
            <field name="arch" type="xml">
                <form string="Expense Distribution" create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group name="distribution_info">
                                <field name="expense_id"/>
                                <field name="partner_id"/>
                                <field name="distribution_method"/>
                                <field name="distribution_date"/>
                            </group>
                            <group name="calculation_details">
                                <field name="partner_share"/>
                                <field name="share_percentage" widget="percentage"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Expense Distribution Search View -->
        <record id="view_real_estate_expense_distribution_search" model="ir.ui.view">
            <field name="name">real.estate.expense.distribution.search</field>
            <field name="model">real.estate.expense.distribution</field>
            <field name="arch" type="xml">
                <search string="Expense Distributions">
                    <field name="expense_id"/>
                    <field name="partner_id"/>
                    <field name="status"/>
                    <field name="distribution_method"/>
                    <field name="distribution_date"/>
                    
                    <filter string="By Percentage" name="percentage" domain="[('distribution_method', '=', 'percentage')]"/>
                    <filter string="Equally" name="equal" domain="[('distribution_method', '=', 'equal')]"/>
                    
                    <separator/>
                    <filter string="This Month" name="this_month" 
                            domain="[('distribution_date', '>=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01')), 
                                   ('distribution_date', '&lt;', (context_today() + relativedelta(months=1)).strftime('%Y-%m-01'))]"/>
                    
                    <group expand="0" string="Group By">
                        <filter string="Expense" name="group_expense" context="{'group_by': 'expense_id'}"/>
                        <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Distribution Method" name="group_method" context="{'group_by': 'distribution_method'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Expense Distribution Action -->
        <record id="action_real_estate_expense_distribution" model="ir.actions.act_window">
            <field name="name">Expense Distributions</field>
            <field name="res_model">real.estate.expense.distribution</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create expense distributions to track how company expenses are split among partners
                </p>
                <p>
                    Use this to manage and track expense distributions before creating actual transactions.
                </p>
            </field>
        </record>

    </data>
</odoo>
