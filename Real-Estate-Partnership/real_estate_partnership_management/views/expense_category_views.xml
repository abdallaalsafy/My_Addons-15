<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Expense Category Tree View -->
        <record id="view_real_estate_expense_category_tree" model="ir.ui.view">
            <field name="name">real.estate.expense.category.tree</field>
            <field name="model">real.estate.expense.category</field>
            <field name="arch" type="xml">
                <tree string="Expense Categories">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="expense_count"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Expense Category Form View -->
        <record id="view_real_estate_expense_category_form" model="ir.ui.view">
            <field name="name">real.estate.expense.category.form</field>
            <field name="model">real.estate.expense.category</field>
            <field name="arch" type="xml">
                <form string="Expense Category">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Category Name"/>
                            </h1>
                            <h2>
                                <field name="code" readonly="1"/>
                            </h2>
                        </div>
                        <group>
                            <group name="category_info">
                                <field name="code"/>
                                <field name="active"/>
                            </group>
                            <group name="category_stats">
                                <field name="expense_count" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group name="description">
                                <field name="description" placeholder="Add category description..."/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Expense Category Search View -->
        <record id="view_real_estate_expense_category_search" model="ir.ui.view">
            <field name="name">real.estate.expense.category.search</field>
            <field name="model">real.estate.expense.category</field>
            <field name="arch" type="xml">
                <search string="Expense Categories">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="description"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <filter string="With Expenses" name="with_expenses" domain="[('expense_count', '>', 0)]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Active Status" name="group_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Expense Category Action -->
        <record id="action_real_estate_expense_category" model="ir.actions.act_window">
            <field name="name">Expense Categories</field>
            <field name="res_model">real.estate.expense.category</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_active': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first expense category
                </p>
                <p>
                    Expense categories help you organize and classify different types of expenses
                    for better reporting and analysis.
                </p>
            </field>
        </record>
    </data>
</odoo>
