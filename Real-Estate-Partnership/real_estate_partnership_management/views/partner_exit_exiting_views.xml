<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View for Exiting Partners -->
        <record id="view_real_estate_partner_exit_exiting_tree" model="ir.ui.view">
            <field name="name">real.estate.partner.exit.exiting.tree</field>
            <field name="model">real.estate.partner.exit.exiting</field>
            <field name="arch" type="xml">
                <tree string="Exiting Partners">
                    <field name="exit_id"/>
                    <field name="partner_id"/>
                    <field name="investment_id"/>
                    <field name="exit_type"/>
                    <field name="investment_percentage" force_save="1"/>
                    <field name="exit_percentage"/>
                </tree>
            </field>
        </record>

        <!-- Form View for Exiting Partners -->
        <record id="view_real_estate_partner_exit_exiting_form" model="ir.ui.view">
            <field name="name">real.estate.partner.exit.exiting.form</field>
            <field name="model">real.estate.partner.exit.exiting</field>
            <field name="arch" type="xml">
                <form string="Exiting Partner">
                    <sheet>
                        <group>
                            <group>
                                <field name="exit_id"/>
                                <field name="partner_id" />
                                <field name="investment_id"/>
                            </group>
                            <group>
                                <field name="exit_type"/>
                                <field name="investment_percentage"/>
                                <field name="exit_percentage"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
