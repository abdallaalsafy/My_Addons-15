#: code:addons/real_estate_partnership_management_pro/models/expense.py:0
#, python-format
msgid "Cannot delete an expense that exceeds the remaining expenses."
msgstr "لا يمكن حذف مصروف يتجاوز المصروفات المتبقية."

#. module: real_estate_partnership_management_pro
#: code:addons/real_estate_partnership_management_pro/models/transaction.py:0
#, python-format
msgid ""
"Cannot delete or modify transactions that affect balance for inactive "
"partners. Partner \"%s\" is currently %s."
msgstr ""
"لا يمكن حذف أو تعديل المعاملات التي تؤثر على الرصيد الخاص بالشركاء غير "
"النشطين. الشريك \"%s\" حالياً %s."

#. module: real_estate_partnership_management_pro
#: code:addons/real_estate_partnership_management_pro/models/property.py:0
