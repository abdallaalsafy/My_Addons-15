<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
                <!-- Property Investment Search View -->
        <record id="view_real_estate_property_investment_search" model="ir.ui.view">
            <field name="name">real.estate.property.investment.search</field>
            <field name="model">real.estate.property.investment</field>
            <field name="arch" type="xml">
                <search string="Property Investments">
                    <field name="name"/>
                    <field name="deal_id"/>
                    <field name="partner_id"/>
                    <field name="status"/>
                    <field name="investment_method"/>
                    <field name="investment_date"/>
                    <filter string="opening" name="opening" domain="[('status', '=', 'opening')]"/>
                    <filter string="closed" name="closed" domain="[('status', '=', 'closed')]"/>
                    <separator/>
                    <filter string="Percentage Method" name="percentage_method" domain="[('investment_method', '=', 'percentage')]"/>
                    <filter string="Amount Method" name="amount_method" domain="[('investment_method', '=', 'amount')]"/>
                    <separator/>
                    <filter string="This Month" name="this_month"
                            domain="[('investment_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                    ('investment_date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                    <filter string="This Year" name="this_year"
                            domain="[('investment_date', '&gt;=', (context_today() - relativedelta(day=1, month=1)).strftime('%Y-%m-%d')),
                                    ('investment_date', '&lt;=', (context_today() + relativedelta(day=31, month=12)).strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                        <filter string="Deal" name="group_deal" context="{'group_by': 'deal_id'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Investment Date" name="group_date" context="{'group_by': 'investment_date'}"/>
                        <filter string="Investment Method" name="group_investment_method" context="{'group_by': 'investment_method'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Property Investment Tree View -->
        <record id="view_real_estate_property_investment_tree" model="ir.ui.view">
            <field name="name">real.estate.property.investment.tree</field>
            <field name="model">real.estate.property.investment</field>
            <field name="arch" type="xml">
                <tree string="Property Investments">
                    <field name="name"/>
                    <field name="deal_id"/>
                    <field name="partner_id"/>
                    <field name="percentage"/>
                    <field name="amount" widget="monetary" sum="Total Amount"/>
                    <field name="down_payment" widget="monetary" sum="Total Down Payment"/>
                    <field name="remaining_amount" widget="monetary" sum="Total Remaining"/>
                    <field name="investment_date"/>
                    <field name="status" widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- Property Investment Form View -->
        <record id="view_real_estate_property_investment_form" model="ir.ui.view">
            <field name="name">real.estate.property.investment.form</field>
            <field name="model">real.estate.property.investment</field>
            <field name="arch" type="xml">
                <form string="Property Investment">
                    <header>
                        <field name="status" widget="statusbar" 
                               statusbar_visible="opening"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group name="investment_details" string="Investment Details">
                                <field name="investment_date"/>
                                <field name="partner_id" readonly="context.get('default_partner_id')" context="{'default_is_partner': True}"/>
                                <field name="deal_id" readonly="context.get('default_deal_id')"/>
                                <field name="investment_method"/>
                            </group>
                            <group string="Financial Details">
                                <field name="percentage"/>
                                <field name="amount" widget="monetary"/>
                                <field name="down_payment" widget="monetary"/>
                                <field name="remaining_amount" widget="monetary"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Payment Installments">
                                <field name="payment_line_ids">
                                    <tree string="Payment Installments" editable="buttom">
                                        <field name="name" readonly="1"/>
                                        <field name="amount"/>
                                        <field name="payment_date"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes" placeholder="Add any notes about this investment..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Property Investment Action -->
        <record id="action_real_estate_property_investment" model="ir.actions.act_window">
            <field name="name">Deal Investments</field>
            <field name="res_model">real.estate.property.investment</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first investment
                </p>
            </field>
        </record>
    </data>
</odoo>
