<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Property Sale Search View -->
        <record id="view_real_estate_property_sale_lines_search" model="ir.ui.view">
            <field name="name">real.estate.sale.lines.search</field>
            <field name="model">real.estate.sale.line</field>
            <field name="arch" type="xml">
                <search string="Property Sales Lines">
                    <field name="property_id"/>
                    <field name="property_date"/>
                    <field name="investment_id"/>
                    <field name="partner_id"/>
                    <separator/>
                    <filter string="Profit This Month" name="profit_this_month" domain="[('property_date', '>=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Profit This Year" name="profit_this_year" domain="[('property_date', '>=', (context_today() - relativedelta(years=1)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Profit This Quarter" name="profit_this_quarter" domain="[('property_date', '>=', (context_today() - datetime.timedelta(days=90)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Profit This Week" name="profit_this_week" domain="[('property_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Profit This Day" name="profit_today" domain="[('property_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                        <filter string="Property Date" name="group_property_date" context="{'group_by': 'property_date'}"/>
                        <filter string="Investment" name="group_investment" context="{'group_by': 'investment_id'}"/>
                        <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
                    </group>

                </search>
            </field>
        </record>

        <!-- Property Sale Line Tree View -->
        <record id="view_real_estate_sale_lines_tree" model="ir.ui.view">
            <field name="name">real.estate.sale.lines.tree</field>
            <field name="model">real.estate.sale.line</field>
            <field name="arch" type="xml">
                <tree string="Property Sales Lines" create="0" delete="0">
                    <field name="company_currency" invisible="1"/>
                    <field name="property_id"/>
                    <field name="property_date"/>
                    <field name="investment_id"/>
                    <field name="partner_id"/>
                    <field name="profit_amount" sum="Total Profits"/>
                </tree>
            </field>
        </record>

        <!-- Property Sale Line Form View -->
        <record id="view_real_estate_sale_lines_form" model="ir.ui.view">
            <field name="name">real.estate.sale.lines.form</field>
            <field name="model">real.estate.sale.line</field>
            <field name="arch" type="xml">
                <form string="Property Sale Line" create="0" delete="0" edit="0">
                    <field name="company_currency" invisible="1"/>
                    <sheet>
                        <group>
                            <field name="property_id"/>
                            <field name="property_date"/>
                            <field name="investment_id"/>
                            <field name="partner_id"/>
                            <field name="profit_amount"/>
                        </group>
                        
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Property Sale Line Action -->
        <record id="action_real_estate_property_sale_lines" model="ir.actions.act_window">
            <field name="name">Property Sales Lines</field>
            <field name="res_model">real.estate.sale.line</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Profits Found
                </p>
            </field>
        </record>
    </data>
</odoo>
