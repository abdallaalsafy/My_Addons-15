<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
                <!-- partnership Search View -->
        <record id="view_real_estate_partnership_search" model="ir.ui.view">
            <field name="name">real.estate.partnership.search</field>
            <field name="model">real.estate.partnership</field>
            <field name="arch" type="xml">
                <search string="Partnerships">
                    <field name="name"/>
                    <field name="investment_id"/>
                    <field name="partner_id"/>
                    <field name="status"/>
                    <field name="investment_method"/>
                    <field name="partnership_date"/>
                    <filter string="opening" name="opening" domain="[('status', '=', 'opening')]"/>
                    <filter string="closed" name="closed" domain="[('status', '=', 'closed')]"/>
                    <separator/>
                    <filter string="Percentage Method" name="percentage_method" domain="[('investment_method', '=', 'percentage')]"/>
                    <filter string="Amount Method" name="amount_method" domain="[('investment_method', '=', 'amount')]"/>
                    <separator/>
                    <filter string="This Month" name="this_month"
                            domain="[('partnership_date', '&gt;=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d')),
                                    ('partnership_date', '&lt;=', (context_today() + relativedelta(days=31)).strftime('%Y-%m-%d'))]"/>
                    <filter string="This Year" name="this_year"
                            domain="[('partnership_date', '&gt;=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d')),
                                    ('partnership_date', '&lt;=', (context_today() + relativedelta(days=31)).strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <filter string="Fully Paid" name="fully_paid" domain="[('remaining_amount', '&lt;=', 0)]"/>
                    <filter string="Pending Payment" name="pending_payment" domain="[('remaining_amount', '&gt;', 0)]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                        <filter string="Investment" name="group_investment" context="{'group_by': 'investment_id'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Partnership Date" name="group_date" context="{'group_by': 'partnership_date'}"/>
                        <filter string="Investment Method" name="group_investment_method" context="{'group_by': 'investment_method'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- partnership Tree View -->
        <record id="view_real_estate_partnership_tree" model="ir.ui.view">
            <field name="name">real.estate.partnership.tree</field>
            <field name="model">real.estate.partnership</field>
            <field name="arch" type="xml">
                <tree string="partnerships">
                    <field name="company_currency" invisible="1"/>
                    <field name="name"/>
                    <field name="investment_id"/>
                    <field name="partner_id"/>
                    <field name="percentage"/>
                    <field name="amount" sum="Total Amount"/>
                    <field name="down_payment" sum="Total Down Payment"/>
                    <field name="remaining_amount" sum="Total Remaining"/>
                    <field name="partnership_date"/>
                    <field name="status" widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- partnership Form View -->
        <record id="view_real_estate_partnership_form" model="ir.ui.view">
            <field name="name">real.estate.partnership.form</field>
            <field name="model">real.estate.partnership</field>
            <field name="arch" type="xml">
                <form string="Partnership">
                    <header>
                        <field name="status" widget="statusbar" 
                               statusbar_visible="opening"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                                <field name="company_currency" invisible="1"/>
                            </h1>
                        </div>
                        <group>
                            <group name="partnership_details" string="Partnership Details">
                                <field name="partnership_date"/>
                                <field name="partner_id" readonly="context.get('default_partner_id')" context="{'default_is_partner': True}"/>
                                <field name="investment_id" readonly="context.get('default_investment_id')"/>
                                <field name="investment_method"/>
                            </group>
                            <group string="Financial Details">
                                <field name="percentage" attrs="{'readonly': [('investment_method', '=', 'amount')]}"/>
                                <field name="amount"/>
                                <field name="down_payment"/>
                                <field name="remaining_amount"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Payment Installments">
                                <field name="payment_line_ids">
                                    <tree string="Payment Installments" editable="bottom">
                                        <field name="company_currency" invisible="1"/>
                                        <field name="name" readonly="1"/>
                                        <field name="auto_create_transaction" attrs="{'readonly': [('id', '!=', False)]}"/>
                                        <field name="amount"/>
                                        <field name="payment_date"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes" placeholder="Add any notes about this partnership..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- partnership Action -->
        <record id="action_real_estate_partnership" model="ir.actions.act_window">
            <field name="name">Investment Partnerships</field>
            <field name="res_model">real.estate.partnership</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first partnership
                </p>
            </field>
        </record>
    </data>
</odoo>
