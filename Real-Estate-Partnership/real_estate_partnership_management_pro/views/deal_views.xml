<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
          <!-- deal Search View -->
        <record id="view_real_estate_deal_search" model="ir.ui.view">
            <field name="name">real.estate.deal.search</field>
            <field name="model">real.estate.deal</field>
            <field name="arch" type="xml">
                <search string="Properties">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="deal_type"/>
                    <separator/>
                    <filter string="House" name="house" domain="[('deal_type', '=', 'house')]"/>
                    <filter string="Apartment" name="apartment" domain="[('deal_type', '=', 'apartment')]"/>
                    <filter string="Land" name="land" domain="[('deal_type', '=', 'land')]"/>
                    <filter string="Building" name="building" domain="[('deal_type', '=', 'building')]"/>
                    <filter string="Villa" name="villa" domain="[('deal_type', '=', 'villa')]"/>
                    <filter string="Shop" name="shop" domain="[('deal_type', '=', 'shop')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="deal Type" name="group_type" context="{'group_by': 'deal_type'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- deal Tree View -->
        <record id="view_real_estate_deal_tree" model="ir.ui.view">
            <field name="name">real.estate.deal.tree</field>
            <field name="model">real.estate.deal</field>
            <field name="arch" type="xml">
                <tree string="Properties">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="deal_type"/>
                    <field name="status" widget="badge"
                           decoration-success="status=='opening'"
                           decoration-danger="status=='closed'"/>
                </tree>
            </field>
        </record>

        <!-- deal Form View -->
        <record id="view_real_estate_deal_form" model="ir.ui.view">
            <field name="name">real.estate.deal.form</field>
            <field name="model">real.estate.deal</field>
            <field name="arch" type="xml">
                <form string="deal">
                    <header>
                        <field name="draft_sold_contracts_count" invisible="1"/>
                        <field name="is_restructured" invisible="1"/>
                        <button name="action_create_purchased_contract" type="object" 
                                string="Create Purchase" class="btn-warning"
                                attrs="{'invisible':[('status','=','closed')]}"/>
                        <button name="action_create_sold_contract" type="object" 
                                string="Create Sale" class="btn-success"
                                attrs="{'invisible':['|',('status','=','closed'),('remaining_area','=',0)]}"/>
                        <button name="action_create_investment" type="object" 
                                string="Create Investment" class="btn-primary"
                                attrs="{'invisible':['|',('status','=','closed'),'&amp;',('total_investments_percentage','=',100),('investment_method','=','percentage')]}"/>
                        <button name="action_add_expense" type="object" 
                                string="Create Expense" class="btn-info"
                                attrs="{'invisible':[('status','=','closed')]}"/>
                        <button name="action_close_deal" type="object" 
                                string="Close Deal" class="btn-info"
                                attrs="{'invisible':['|','|','|',('draft_sold_contracts_count','>',0),('remaining_area','>',0),('status','=','closed'),('total_area','=',0)]}"/>
                        <button name="action_reopen_deal" type="object" 
                                string="Reopen Deal" class="btn-info"
                                attrs="{'invisible':['|',('status','=','opening'),('is_restructured','=',True)]}"/>
                        <button name="action_restructuring_deal" type="object" 
                                string="Restructuring Deal" class="btn-info"
                                attrs="{'invisible':['|','|','|','|',('total_investments_percentage','&lt;',100),('draft_sold_contracts_count','=',0),('remaining_area','>',0),('status','=','closed'),('total_area','=',0)]}"/>
                        <field name="status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_purchased_contracts" type="object"
                                    class="oe_stat_button" icon="fa-shopping-cart" attrs="{'invisible':[('purchased_contracts_count','=',0)]}">
                                <field name="purchased_contracts_count" widget="statinfo"
                                       string="Purchased"/>
                            </button>
                            <button name="action_view_sold_contracts" type="object"
                                    class="oe_stat_button" icon="fa-cart-arrow-down" attrs="{'invisible':[('sold_contracts_count','=',0)]}">
                                <field name="sold_contracts_count" widget="statinfo"
                                       string="Sales"/>
                            </button>
                            <button name="action_view_investments" type="object"
                                    class="oe_stat_button" icon="fa-money" attrs="{'invisible':[('investment_count','=',0)]}">
                                <field name="investment_count" widget="statinfo"
                                       string="Investments"/>
                            </button>
                            <button name="action_view_expenses" type="object"
                                    class="oe_stat_button" icon="fa-file-text-o" attrs="{'invisible':[('expense_count','=',0)]}">
                                <field name="expense_count" widget="statinfo" string="Expenses"/>
                            </button>
                            <button name="action_view_deal_profit" type="object"
                                    class="oe_stat_button" icon="fa-line-chart"  attrs="{'invisible': [('profit_count', '=', 0)]}">
                                <field name="profit_count" widget="statinfo" string="Profits"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="deal Name"/>
                            </h1>
                            <h2>
                                <field name="code" readonly="1"/>
                            </h2>
                        </div>
                        <group>
                            <group string="Open Date">
                                <field name="open_date"/>
                            </group>
                            <group string="Close Date">
                                <field name="close_date"/>
                            </group>
                        </group>
                        <group>
                            <group string="Basic Information &amp; Financials">
                                <field name="deal_type"/>
                                <field name="total_current_value"/>
                                <field name="total_expenses" widget="monetary"/>
                                <field name="total_deal_cost" widget="monetary"/>
                            </group>
                            <group string="Investment &amp; Profit Information">
                                <field name="total_investments_percentage"/>
                                <field name="total_investments" widget="monetary"/>
                            </group>
                        </group>
                        <group>
                            <group name="area_specs" string="deal Specifications">
                                <field name="area_unit"/>
                                <field name="total_area"/>
                                <field name="sold_area"/>
                                <field name="remaining_area"/>
                            </group>
                            <group name="location" string="Location Information">
                                <field name="city_id"/>
                                <field name="address"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Documents">
                                <field name="attachment_ids" widget="many2many_binary"/>
                                <p class="text-muted">
                                    Upload deal documents, images, contracts, ownership papers, 
                                    architectural plans, and other relevant files here.
                                </p>
                            </page>
                            <page string="Description &amp; Notes">
                                <group>
                                    <field name="description" placeholder="Detailed description of the deal..."/>
                                    <field name="notes" placeholder="Additional notes..."/>
                                </group>
                            </page>
                            <page string="Deal Details" attrs="{'invisible': [('purchased_contracts_count', '=', 0)]}">
                                <group>
                                    <group string="Rooms &amp; Area" attrs="{'invisible': [('deal_type', 'not in', ['house', 'apartment', 'villa', 'building'])]}">
                                        <field name="total_rooms"/>
                                        <field name="bedrooms"/>
                                        <field name="bathrooms"/>
                                        <field name="kitchens"/>
                                        <field name="living_rooms"/>
                                        <field name="built_area"/>
                                        <field name="number_of_floors"/>
                                    </group>
                                    <group string="Boundaries">
                                        <field name="north_boundary" placeholder="What borders from north" attrs="{'readonly': [('purchased_contracts_count', '=', 1)]}"/>
                                        <field name="south_boundary" placeholder="What borders from south" attrs="{'readonly': [('purchased_contracts_count', '=', 1)]}"/>
                                        <field name="east_boundary" placeholder="What borders from east" attrs="{'readonly': [('purchased_contracts_count', '=', 1)]}"/>
                                        <field name="west_boundary" placeholder="What borders from west" attrs="{'readonly': [('purchased_contracts_count', '=', 1)]}"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Settings">
                                <group>
                                    <field name="investment_method" widget="radio"/>
                                </group>
                                <div class="alert alert-info" role="alert">
                                    <strong>Investment Method:</strong>
                                    <ul>
                                        <li><b>Percentage:</b> When this method is selected, users enter the investment percentage for each partner, and the system automatically calculates the amount based on the total cost of the deal.</li>
                                        <li><b>Amount:</b> When this method is selected, users enter the investment amount directly, and the system automatically calculates the percentage based on the total investments in the deal.</li>
                                    </ul>
                                    <p><strong>Note:</strong> The investment method set it before adding any investments to the deal.</p>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- deal Kanban View -->
        <record id="view_real_estate_deal_kanban" model="ir.ui.view">
            <field name="name">real.estate.deal.kanban</field>
            <field name="model">real.estate.deal</field>
            <field name="arch" type="xml">
                <kanban string="Properties">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="deal_type"/>
                    <field name="total_deal_cost"/>
                    <field name="status"/>
                    <field name="color"/>
                    <field name="attachment_ids"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click #{record.status.raw_value == 'sold' ? 'o_kanban_disabled' : ''}">
                                <div class="o_kanban_card_header">
                                    <div class="o_kanban_card_header_title">
                                        <strong><field name="name"/></strong>
                                    </div>
                                    <div class="o_kanban_manage_button_section">
                                        <a class="o_kanban_manage_toggle_button" href="#" tabindex="-1">
                                            <i class="fa fa-ellipsis-v" role="img" aria-label="Manage" title="Manage"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="o_kanban_card_content">
                                    <div class="o_kanban_primary_left">
                                        <div class="o_kanban_record_bottom">
                                            <div class="o_text_overflow">
                                                <span><field name="code"/></span>
                                            </div>
                                        </div>
                                        <div class="o_kanban_record_bottom">
                                            <div class="o_text_overflow">
                                                <field name="deal_type"/>
                                            </div>
                                        </div>
                                        <div class="o_kanban_record_bottom">
                                            <div class="o_text_overflow">
                                                <strong>Total Cost: </strong><field name="total_deal_cost" widget="monetary"/>
                                            </div>
                                        </div>
                                        <div class="o_kanban_record_bottom" t-if="record.attachment_ids.raw_value and record.attachment_ids.raw_value.length > 0">
                                            <div class="o_text_overflow">
                                                <i class="fa fa-paperclip" title="Has Documents"/>
                                                <span t-esc="record.attachment_ids.raw_value.length + ' Documents'"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="o_kanban_primary_right">
                                        <field name="status" widget="label_selection" 
                                               options="{'classes': {'available': 'success', 'sold': 'danger'}}"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- deal Action -->
        <record id="action_real_estate_deal" model="ir.actions.act_window">
            <field name="name">Deals</field>
            <field name="res_model">real.estate.deal</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first deal
                </p>
            </field>
        </record>
    </data>
</odoo>
