<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Investment Payment Search View -->
        <record id="view_investment_payment_search" model="ir.ui.view">
            <field name="name">real.estate.investment.payment.search</field>
            <field name="model">real.estate.investment.payment</field>
            <field name="arch" type="xml">
                <search string="Investment Payments">
                    <field name="name"/>
                    <field name="investment_id"/>
                    <field name="partner_id" string="Partner" filter_domain="[('investment_id.partner_id', 'ilike', self)]"/>
                    <field name="payment_date"/>
                    <separator/>
                    <filter string="This Month" name="this_month" domain="[('payment_date', '>=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d')), ('payment_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter string="This Year" name="this_year" domain="[('payment_date', '>=', (context_today() - relativedelta(days=365)).strftime('%Y-%m-%d')), ('payment_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                    
                    <group expand="0" string="Group By">
                        <filter string="Investment" name="group_investment" context="{'group_by': 'investment_id'}"/>
                        <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                        <filter string="Payment Date" name="group_payment_date" context="{'group_by': 'payment_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Investment Payment Tree View -->
        <record id="view_investment_payment_tree" model="ir.ui.view">
            <field name="name">real.estate.investment.payment.tree</field>
            <field name="model">real.estate.investment.payment</field>
            <field name="arch" type="xml">
                <tree string="Investment Payments">
                    <field name="name"/>
                    <field name="investment_id"/>
                    <field name="partner_id"/>
                    <field name="amount" widget="monetary" sum="Total Amount"/>
                    <field name="payment_date"/>
                </tree>
            </field>
        </record>

        <!-- Investment Payment Form View -->
        <record id="view_investment_payment_form" model="ir.ui.view">
            <field name="name">real.estate.investment.payment.form</field>
            <field name="model">real.estate.investment.payment</field>
            <field name="arch" type="xml">
                <form string="Investment Payment">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="investment_id" readonly="context.get('default_investment_id')"/>
                                <field name="partner_id"/>
                                <field name="amount"/>
                                <field name="payment_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes">
                                <field name="notes" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Investment Payment Action -->
        <record id="action_investment_payment" model="ir.actions.act_window">
            <field name="name">Investment Payments</field>
            <field name="res_model">real.estate.investment.payment</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first investment payment installment
                </p>
            </field>
        </record>
    </data>
</odoo>
