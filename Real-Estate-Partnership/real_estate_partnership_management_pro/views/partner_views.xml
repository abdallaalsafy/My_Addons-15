<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_res_partner_filter" model="ir.ui.view">
            <field name="name">res.partner.select</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="code"/>
                </xpath>
                <xpath expr="//filter[@name='inactive']" position="after">
                    <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                    <filter string="Exited" name="exited" domain="[('status', '=', 'exited')]"/>
                    <separator/>
                    <filter string="With Balance" name="with_balance" domain="[('current_balance', '>', 0)]"/>
                    <filter string="No Balance" name="no_balance" domain="[('current_balance', '=', 0)]"/>
                    <separator/>
                </xpath>
                 <xpath expr="//group[@name='group_by']" position="inside">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Join Date" name="group_join_date" context="{'group_by': 'join_date'}"/>
                </xpath>
            </field>
        </record>

        <record id="view_partner_tree" model="ir.ui.view">
            <field name="name">res.partner.tree</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                 <xpath expr="//field[@name='display_name']" position="before">
                    <field name="code" readonly="1"/>
                </xpath>
                 <xpath expr="//field[@name='display_name']" position="after">
                    <field name="nickname" readonly="1"/>
                    <field name="national_id" readonly="1"/>
                    <field name="status" widget="badge" decoration-success="status=='active'" decoration-danger="status=='exited'"/>
                    <field name="join_date"/>
                </xpath>
            </field>
        </record>

        <record id="view_partner_form" model="ir.ui.view">
            <field name="name">res.partner.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@role='alert']" position="before">
                    <header>
                        <field name="is_partner" invisible="1"/>
                        <field name="is_seller" invisible="1"/>
                        <field name="is_buyer" invisible="1"/>
                        <field name="is_payee" invisible="1"/>
                        <button name="action_create_investment" type="object"
                            string="Create Investment" class="btn-primary"
                            attrs="{'invisible': ['|','|',('status', '=', 'exited'),('active', '=', False),('is_partner', '=', False)]}"/>
                        <button name="action_create_transaction" type="object"
                                string="Create Transaction" class="btn-primary"
                                attrs="{'invisible': ['|','|',('status', '=', 'exited'),('active', '=', False),('is_partner', '=', False)]}"/>
                        <button name="action_exit_partnership" type="object"
                                string="Exit Partnership" class="btn-danger"
                                confirm="Are you sure you want to exit this partner from the partnership?"
                                attrs="{'invisible': ['|','|',('status', '=', 'exited'),('active', '=', False),('is_partner', '=', False)]}"/>
                        <button name="action_reactivate" type="object" 
                                string="Reactivate" class="btn-warning"
                                attrs="{'invisible': ['|',('status', '!=', 'exited'),('is_partner', '=', False)]}"/>
                        <button name="action_view_partner_ledger" type="object"
                                    class="btn-info" icon="fa-file-text" string="Balance"
                                    attrs="{'invisible': [('is_partner', '=', False)]}"/>
                        
                        <field name="status" widget="statusbar" 
                                statusbar_visible="active,exited"/>
                    </header>
                </xpath>

                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_transactions" type="object" 
                            class="oe_stat_button" icon="fa-money"
                            attrs="{'invisible': [('transaction_count', '=', 0)]}">
                        <field name="transaction_count" widget="statinfo" string="Transactions"/>
                    </button>
                    <button name="action_view_investments" type="object" 
                            class="oe_stat_button" icon="fa-building"
                            attrs="{'invisible': [('open_investments_count', '=', 0)]}">
                        <field name="open_investments_count" widget="statinfo" string="Investments"/>
                    </button>
                    <button name="action_view_partner_profit" type="object"
                            class="oe_stat_button" icon="fa-line-chart"  attrs="{'invisible': [('profit_count', '=', 0)]}">
                        <field name="profit_count" widget="statinfo" string="Profits"/>
                    </button>

                    <button name="action_view_purchases_contracts" type="object" class="btn-primary" 
                        attrs="{'invisible': [('contract_purchase_count', '=', 0)]}">
                        <field name="contract_purchase_count" widget="statinfo" string="Purchases Contracts"/>
                    </button>
                    <button name="action_view_sale_contracts" type="object" class="btn-primary" 
                        attrs="{'invisible': [('contract_sale_count', '=', 0)]}">
                        <field name="contract_sale_count" widget="statinfo" string="Sale Contracts"/>
                    </button>
                    <button name="action_view_expenses" type="object" class="btn-info" 
                        attrs="{'invisible': [('expense_count', '=', 0)]}">
                        <field name="expense_count" widget="statinfo" string="Expenses"/>
                    </button>
                </xpath>
                
                <xpath expr="//field[@name='company_type']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//field[@name='parent_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                
                <xpath expr="//span[@name='address_name']" position="replace">
                    <field name="type" invisible="1"/>
                   <span  class="o_form_label o_td_label">
                        <b>Address</b>
                    </span>
                </xpath>

                <xpath expr="//page[@name='contact_addresses']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page[@name='sales_purchases']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page[@name='internal_notes']" position="before">
                    <page string="Financial Information" attrs="{'invisible': [('is_partner', '=', False)]}">
                        <group>
                            <group string="Balance &amp; Investments">
                                <field name="current_balance"/>
                                <field name="actual_balance"/>
                                <field name="total_investments"/>
                            </group>
                            <group string="Expenses &amp; Profits">
                                <field name="total_expenses"/>
                                <field name="total_profits"/>
                            </group>
                        </group>
                    </page>
                </xpath>

                <xpath expr="//h1" position="after">
                    <h2>
                        <field name="code" readonly="1"/>
                    </h2>
                </xpath>
                <xpath expr="//div[@class='o_address_format']" position="after">
                    <field name="nickname"/>
                    <field name="national_id"/>
                    <field name="join_date"/>
                    <field name="exit_date" attrs="{'invisible': [('status', '=', 'active')]}"/>
                </xpath>

            </field>
        </record>
       <!-- Partner Action -->
        <record id="action_real_estate_partner" model="ir.actions.act_window">
            <field name="name">Partners</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="context">{'search_default_active': 1, 'default_is_partner': True,}</field>
            <field name="domain">[('is_partner', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first partner
                </p>
            </field>
        </record>

        <record id="action_real_estate_saller" model="ir.actions.act_window">
            <field name="name">Sallers</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="context">{'search_default_active': 1, 'default_is_seller': True,}</field>
            <field name="domain">[('is_seller', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Saller
                </p>
            </field>
        </record>

        <record id="action_real_estate_buyer" model="ir.actions.act_window">
            <field name="name">Buyers</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="context">{'search_default_active': 1, 'default_is_buyer': True,}</field>
            <field name="domain">[('is_buyer', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Buyer
                </p>
            </field>
        </record>

        <record id="action_real_estate_payee" model="ir.actions.act_window">
            <field name="name">Payees</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="context">{'search_default_active': 1, 'default_is_payee': True,}</field>
            <field name="domain">[('is_payee', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Payee
                </p>
            </field>
        </record>
    </data>
</odoo>
