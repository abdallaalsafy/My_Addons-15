<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_real_estate_partner_details_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="real_estate_partnership_management_pro.report_real_estate_partner_details" t-lang="user.partner_id.lang"/>
                </t>
            </t>
        </template>

        <template id="report_real_estate_partner_details">
            <t t-set="doc" t-value="doc.with_context(lang=user.partner_id.lang)"/>
            <t t-call="web.external_layout">
                <div class="page" style="font-family: 'Tahoma', sans-serif;">
                    <h2 style="text-align: center; margin-bottom: 20px;"><span t-field="doc.name"/></h2>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; width: 50%;"><strong>National ID:</strong> <span t-field="doc.national_id"/></td>
                            <td style="padding: 8px; border: 1px solid #ddd; width: 50%;"><strong>Code:</strong> <span t-field="doc.code"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Nickname:</strong> <span t-field="doc.nickname"/></td>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Email:</strong> <span t-field="doc.email"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Join Date:</strong> <span t-field="doc.join_date"/></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                <strong t-if="doc.status == 'exited'">Exit Date:</strong>
                                <strong t-if="doc.status == 'active'">Status:</strong>
                                <span t-field="doc.exit_date" t-if="doc.status == 'exited'"/>
                                <span t-field="doc.status" t-if="doc.status == 'active'"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Phone:</strong> <span t-field="doc.phone"/></td>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Mobile:</strong> <span t-field="doc.mobile"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;" colspan="2"><strong>Address:</strong> <span t-field="doc.street"/> <span t-field="doc.city"/> <span t-field="doc.country_id.name"/></td>
                        </tr>
                    </table>

                    <h3 style="margin-top: 20px;" t-if="doc.is_partner">Financial Summary</h3>
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;" t-if="doc.is_partner">
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; width: 50%;"><strong>Current Balance:</strong> <span t-esc="doc.company_currency.name"/> <span t-esc="'{:,.2f}'.format(doc.current_balance)"/></td>
                            <td style="padding: 8px; border: 1px solid #ddd; width: 50%;"><strong>Actual Balance:</strong> <span t-esc="doc.company_currency.name"/> <span t-esc="'{:,.2f}'.format(doc.actual_balance)"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Total Opening Partnerships:</strong> <span t-esc="doc.company_currency.name"/> <span t-esc="'{:,.2f}'.format(doc.total_partnerships)"/></td>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Total Profits:</strong> <span t-esc="doc.company_currency.name"/> <span t-esc="'{:,.2f}'.format(doc.total_profits)"/></td>
                        </tr>
                    </table>

                    <h3 style="margin-top: 20px;" t-if="doc.is_partner">Opening Partnerships</h3>
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;" t-if="doc.is_partner">
                        <thead>
                            <tr style="background-color: #f2f2f2;">
                                <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Partnership</th>
                                <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Investment</th>
                                <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">%</th>
                                <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Amount</th>
                                <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Payment</th>
                                <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Remaining</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.partnership_ids" t-as="line">
                                <tr t-if="line.status == 'opening'">
                                    <td style="padding: 8px; border: 1px solid #ddd;"><span t-field="line.name"/></td>
                                    <td style="padding: 8px; border: 1px solid #ddd;"><span t-field="line.investment_id.name"/></td>
                                    <td style="padding: 8px; border: 1px solid #ddd;"><span t-field="line.percentage"/> %</td>
                                    <td style="padding: 8px; border: 1px solid #ddd;"><span t-esc="line.company_currency.name or doc.company_currency.name"/> <span t-esc="'{:,.2f}'.format(line.amount)"/></td>
                                    <td style="padding: 8px; border: 1px solid #ddd;"><span t-esc="line.company_currency.name or doc.company_currency.name"/> <span t-esc="'{:,.2f}'.format(line.down_payment)"/></td>
                                    <td style="padding: 8px; border: 1px solid #ddd;"><span t-esc="line.company_currency.name or doc.company_currency.name"/> <span t-esc="'{:,.2f}'.format(line.remaining_amount)"/></td>
                                </tr>
                            </t>
                            <t t-if="not doc.partnership_ids">
                                <tr>
                                    <td colspan="6" style="padding: 10px; border: 1px solid #ddd; text-align: center;">No partnerships recorded.</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </template>

        <record id="action_report_real_estate_partner_details" model="ir.actions.report">
            <field name="name">Partner Detailed Report</field>
            <field name="model">res.partner</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">real_estate_partnership_management_pro.report_real_estate_partner_details_document</field>
            <field name="report_file">real_estate_partnership_management_pro.report_real_estate_partner_details_document</field>
            <field name="print_report_name">'Partner Report - %s' % (object.name)</field>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
