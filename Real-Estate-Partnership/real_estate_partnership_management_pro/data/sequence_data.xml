<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
            <!-- Sequences -->
        <record id="seq_real_estate_partner" model="ir.sequence">
            <field name="name">Real Estate Partner</field>
            <field name="code">real.estate.partner</field>
