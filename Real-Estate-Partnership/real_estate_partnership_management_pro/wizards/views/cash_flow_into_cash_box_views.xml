<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
                <!-- Partner Unified Ledger Line Tree View -->
        <record id="view_cash_flow_into_cash_box_line_tree" model="ir.ui.view">
            <field name="name">cash.flow.into.cash.box.line.tree</field>
            <field name="model">cash.flow.into.cash.box.line</field>
            <field name="arch" type="xml">
                <tree string="Daily Cashbox">
                    <field name="company_currency" invisible="1"/>
                    <field name="date"/>
                    <field name="name"/>
                    <field name="transaction_type"/>
                    <field name="description"/>
                    <field name="amount" sum="Total Amount"/>
                    <field name="balance"/>
                </tree>
            </field>
        </record>

        <!-- Partner Unified Ledger Form View -->
        <record id="view_cash_flow_into_cash_box_form" model="ir.ui.view">
            <field name="name">cash.flow.into.cash.box.form</field>
            <field name="model">cash.flow.into.cash.box</field>
            <field name="arch" type="xml">
                <form string="Daily Cashbox">
                    <!-- Filter Section -->
                    <group string="Filters">
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_view_tree_ledger" type="object" string="List View" class="btn-primary"/>
                        <button name="action_print_report" type="object" string="Print" class="btn-primary"/>
                        <button special="cancel" string="Close" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Partner Unified Ledger Action -->
        <record id="action_cash_flow_into_cash_box" model="ir.actions.act_window">
            <field name="name">Daily Cashbox</field>
            <field name="res_model">cash.flow.into.cash.box</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
