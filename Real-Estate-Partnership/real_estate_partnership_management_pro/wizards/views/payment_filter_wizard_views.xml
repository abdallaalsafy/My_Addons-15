<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Payment Filter Wizard Form View -->
        <record id="view_payment_filter_wizard_form" model="ir.ui.view">
            <field name="name">payment.filter.wizard.form</field>
            <field name="model">payment.filter.wizard</field>
            <field name="arch" type="xml">
                <form string="Filter Payments">
                    <sheet>
                        <group>
                            <group>
                                <field name="contract_id"/>
                                <field name="contact_id"/>
                            </group>
                            <group>
                                <field name="payment_type"/>
                                <field name="status"/>
                            </group>
                            <group>
                                <field name="due_date_from"/>
                                <field name="due_date_to"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_filter_payments" type="object" 
                                string="Filter" class="btn-primary"/>
                        <button special="cancel" string="Cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Payment Filter Wizard Action -->
        <record id="action_payment_filter_wizard" model="ir.actions.act_window">
            <field name="name">Filter Payments</field>
            <field name="res_model">payment.filter.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
