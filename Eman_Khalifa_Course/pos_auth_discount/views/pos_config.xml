<odoo>
    <data>
        <record id="pos_config_form_inherit_id" model="ir.ui.view">
        <field name="name">pos.config.form.inherit</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/div[5][contains(@class,'row mt16 o_settings_container')]" position="inside">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="disc_password"/>
                            <div class="text-muted">
                                Write the password to allow user to do discount in pos.
                            </div>
                            <div class="content-group mt16">
                                <field name="disc_password" />
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>